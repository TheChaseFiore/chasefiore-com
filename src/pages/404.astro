---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Chase Fiore">
  <div class="not-found">
    <div class="content">
      <p class="code">404</p>
      <h1>Page Not Found</h1>
      <p class="message">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="home-link">← Back to Home</a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    min-height: calc(100dvh - var(--nav-height) - 80px);
  }

  .content {
    text-align: center;
    max-width: 480px;
  }

  .code {
    font-size: clamp(5rem, 20vw, 10rem);
    font-weight: 200;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.06);
    line-height: 1;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .message {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.35);
    padding: 0.6rem 1.25rem;
    border-radius: 2px;
    transition: background 0.2s, border-color 0.2s;
  }

  .home-link:hover {
    background: rgba(200, 168, 122, 0.1);
    border-color: var(--accent);
  }
</style>
