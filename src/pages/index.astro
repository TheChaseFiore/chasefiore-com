---
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
---

<Layout title="Chase Fiore | Show Set Design">
  <section class="landing">
    <ModelViewer modelUrl="./models/SSE-draco.glb" height="100%" autoRotate={true} sectionCuts={true} mobileDrag={true}>
      <div class="hero-overlay">
        <div class="hero-text">
          <h1>Chase Fiore</h1>
          <p>Show Set Design</p>
        </div>
        <a href="/portfolio/" class="work-cue">
          <span>Selected Works</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
    </ModelViewer>

    <!-- Drifting caption lines — appear after first model interaction -->
    <div id="drift-container" aria-hidden="true">
      <span class="drift-line d1">Modeled in Revit</span>
      <span class="drift-line d2">over the course of 10 days</span>
      <span class="drift-line d3">by myself, for a school project</span>
      <span class="drift-line d4">— 2020</span>
    </div>
  </section>
</Layout>

<script>
  function initDrift() {
    const canvas = document.querySelector<HTMLCanvasElement>('.viewer-canvas');
    const container = document.getElementById('drift-container');
    if (!canvas || !container) return;

    let triggered = false;

    const trigger = () => {
      if (triggered) return;
      triggered = true;
      canvas.removeEventListener('pointerup', trigger);
      setTimeout(() => container.classList.add('active'), 700);
    };

    canvas.addEventListener('pointerup', trigger);
  }

  document.addEventListener('astro:page-load', initDrift);
  initDrift();
</script>

<style>
  .landing {
    position: relative;
    height: calc(100dvh - var(--nav-height));
    overflow: hidden;
  }

  /* ── Hero overlay ── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(12, 12, 12, 0.72) 0%,
      rgba(12, 12, 12, 0.1) 45%,
      transparent 70%
    );
  }

  .hero-text { margin-bottom: 1.5rem; }

  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .hero-text p {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0.4rem;
  }

  .work-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: auto;
    text-decoration: none;
    transition: color 0.2s;
    animation: cue-bob 2s ease-in-out infinite;
  }

  .work-cue:hover { color: var(--accent); }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(4px); }
  }

  /* ── Drifting caption ── */
  #drift-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .drift-line {
    position: absolute;
    white-space: nowrap;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200, 168, 122, 0.55);
    opacity: 0;
  }

  #drift-container.active .drift-line {
    animation: drift-float 11s ease-out forwards;
  }

  .d1 { top: 20%; left: 6%;  animation-delay: 0.1s; }
  .d2 { top: 36%; left: 14%; animation-delay: 1.1s; }
  .d3 { top: 52%; left: 8%;  animation-delay: 2.0s; }
  .d4 { top: 66%; left: 20%; animation-delay: 2.9s; }

  @keyframes drift-float {
    0%   { opacity: 0; transform: translateX(0px); }
    12%  { opacity: 1; }
    72%  { opacity: 0.55; }
    100% { opacity: 0; transform: translateX(110px); }
  }

  @media (max-width: 500px) {
    .hero-overlay { padding: 1.75rem; }
    .d1 { top: 18%; left: 5%; }
    .d2 { top: 32%; left: 8%; }
    .d3 { top: 46%; left: 5%; }
    .d4 { top: 60%; left: 12%; }
  }
</style>
