---
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
---

<Layout title="Chase Fiore | Scenic Design & Photography">

  <!--
    Structure: .hero-pin creates the scroll distance.
    .hero is sticky inside it so it stays fixed while you scroll through .hero-pin.
    The grid section rises up from underneath as the hero fades.
  -->
  <div class="hero-pin">
    <section class="hero">
      <ModelViewer modelUrl="/models/SSE.glb" height="100%" autoRotate={true} debug={true}>
        <div class="hero-overlay">
          <div class="hero-text">
            <svg class="hero-name-svg" viewBox="0 0 600 108" xmlns="http://www.w3.org/2000/svg" aria-label="Chase Fiore" role="img">
              <text class="name-copy" x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3">Chase Fiore</text>
              <text class="name-copy" x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3">Chase Fiore</text>
              <text class="name-copy" x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3">Chase Fiore</text>
              <text class="name-copy" x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3">Chase Fiore</text>
              <text class="name-copy" x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3">Chase Fiore</text>
            </svg>
            <p>Scenic Design &amp; Photography</p>
          </div>
          <div class="scroll-cue" aria-hidden="true">
            <span>Selected Works</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </div>
        </div>
      </ModelViewer>
    </section>
  </div>
</Layout>

<script>
  function initDrift() {
    const canvas = document.querySelector<HTMLCanvasElement>('.viewer-canvas');
    const container = document.getElementById('drift-container');
    if (!canvas || !container) return;

    let triggered = false;

    const trigger = () => {
      if (triggered) return;
      triggered = true;
      canvas.removeEventListener('pointerup', trigger);
      setTimeout(() => container.classList.add('active'), 700);
    };

    canvas.addEventListener('pointerup', trigger);
  }

  document.addEventListener('astro:page-load', initDrift);
  initDrift();
</script>

<style>
  .landing {
    position: relative;
    height: calc(100dvh - var(--nav-height));
    overflow: hidden;
  }

  /* ── Hero overlay ── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(12, 12, 12, 0.72) 0%,
      rgba(12, 12, 12, 0.1) 45%,
      transparent 70%
    );
  }

  .hero-text { margin-bottom: 1.5rem; }

  /* SVG stroke-animated name */
  .hero-name-svg {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    overflow: visible;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 2px 16px rgba(0,0,0,0.75));
  }

  .hero-name-svg .name-copy {
    fill: none;
    stroke-dasharray: 6% 29%;
    stroke-width: 2px;
    stroke-dashoffset: 0%;
    animation: name-march 5.5s infinite linear;
  }

  .hero-name-svg .name-copy:nth-child(1) { stroke: rgba(255,255,255,0.12); animation-delay: -1s; }
  .hero-name-svg .name-copy:nth-child(2) { stroke: #c8a87a;               animation-delay: -2s; }
  .hero-name-svg .name-copy:nth-child(3) { stroke: rgba(255,255,255,0.85); animation-delay: -3s; }
  .hero-name-svg .name-copy:nth-child(4) { stroke: rgba(200,168,122,0.5);  animation-delay: -4s; }
  .hero-name-svg .name-copy:nth-child(5) { stroke: rgba(255,255,255,0.28); animation-delay: -5s; }

  @keyframes name-march {
    100% { stroke-dashoffset: -35%; }
  }

  .hero-text p {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0;
  }

  .work-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: auto;
    text-decoration: none;
    transition: color 0.2s;
    animation: cue-bob 2s ease-in-out infinite;
  }

  .work-cue:hover { color: var(--accent); }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(4px); }
  }

  /* ── Drifting caption ── */
  #drift-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .drift-line {
    position: absolute;
    white-space: nowrap;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(200, 168, 122, 0.55);
    opacity: 0;
  }

  #drift-container.active .drift-line {
    animation: drift-float 11s ease-out forwards;
  }

  .d1 { top: 20%; left: 6%;  animation-delay: 0.1s; }
  .d2 { top: 36%; left: 14%; animation-delay: 1.1s; }
  .d3 { top: 52%; left: 8%;  animation-delay: 2.0s; }
  .d4 { top: 66%; left: 20%; animation-delay: 2.9s; }

  @keyframes drift-float {
    0%   { opacity: 0; transform: translateX(0px); }
    12%  { opacity: 1; }
    72%  { opacity: 0.55; }
    100% { opacity: 0; transform: translateX(110px); }
  }

  @media (max-width: 500px) {
    .hero-overlay { padding: 1.75rem; }
    .d1 { top: 18%; left: 5%; }
    .d2 { top: 32%; left: 8%; }
    .d3 { top: 46%; left: 5%; }
    .d4 { top: 60%; left: 12%; }
  }
</style>

{debug && (
  <div class="viewer-debug">
    Camera: <span id="camera-pos"></span><br>
    Target: <span id="camera-target"></span>
  </div>
)}
