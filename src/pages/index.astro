---
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
import { SITE_NAME, TAGLINE } from '../config';
---

<Layout title={`${SITE_NAME} | ${TAGLINE}`}>

  <!--
    Structure: .hero-pin creates the scroll distance.
    .hero is sticky inside it so it stays fixed while you scroll through .hero-pin.
    The grid section rises up from underneath as the hero fades.
  -->
  <div class="hero-pin">
    <section class="hero">
      <ModelViewer
        modelUrl="/models/SSE-draco.glb"
        height="100%"
        autoRotate={true}
        navArrows={true}
        cameraPos={[-1.88, 1.31, -3.15]}
        cameraTgt={[-0.49, 0.12, 0.08]}
        cycleModels={[
          {url: '/models/Streetcar-draco.glb', cameraPos: [-2.94, 0.42, 1.03], cameraTgt: [0.56, 0.56, 0.67]},
          {url: '/models/Charlie_Brown-draco.glb', cameraPos: [4.58, 2.40, 5.21], cameraTgt: [1.25, 0.84, 0.31]},
          {url: '/models/Coffee_Shop-draco.glb', cameraPos: [-1.59, 1.17, 5.09], cameraTgt: [-2.66, 0.83, 1.52]},
          {url: '/models/SSE-draco.glb', cameraPos: [-1.88, 1.31, -3.15], cameraTgt: [-0.49, 0.12, 0.08]},
        ]}
      >
        <div class="hero-overlay">
          <div class="hero-text">
            <svg class="hero-name-svg" viewBox="0 0 600 108" xmlns="http://www.w3.org/2000/svg" aria-label="Chase Fiore" role="img">
              <text x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3" fill="rgba(255,255,255,0.92)">Chase Fiore</text>
            </svg>
            <p>{TAGLINE}</p>
          </div>
        </div>
      </ModelViewer>

      <div class="hero-name-mobile" aria-hidden="true">
        <svg class="hero-name-svg" viewBox="0 0 600 108" xmlns="http://www.w3.org/2000/svg" aria-label="Chase Fiore">
          <text x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3" fill="rgba(255,255,255,0.92)">Chase Fiore</text>
        </svg>
        <p>{TAGLINE}</p>
      </div>
    </section>
  </div>
</Layout>


<style>
  /* ── Disable scroll on landing page ── */
  :global(body) {
    overflow: hidden;
  }

  /* ── Hero layout ── */
  .hero-pin {
    height: calc(100dvh - var(--nav-height));
  }

  .hero {
    height: 100%;
  }

  /* ── Hero overlay ── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 11;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(12, 12, 12, 0.72) 0%,
      rgba(12, 12, 12, 0.1) 45%,
      transparent 70%
    );
  }

  .hero-text { margin-bottom: 1.5rem; }

  /* SVG stroke-animated name */
  .hero-name-svg {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    overflow: visible;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 2px 16px rgba(0,0,0,0.75));
  }

  .hero-text p {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0;
  }

  /* ── Mobile name (below model) ── */
  .hero-name-mobile {
    display: none;
  }

  @media (max-width: 600px) {
    .hero {
      display: flex;
      flex-direction: column;
    }

    .hero .viewer-root {
      flex: 1;
      min-height: 0;
      height: auto !important;
    }

    .hero-text {
      display: none;
    }

    .hero-name-mobile {
      display: block;
      flex-shrink: 0;
      padding: 1rem 1.75rem 1.25rem;
      background: var(--bg);
    }

    .hero-name-mobile p {
      font-size: clamp(0.75rem, 3.5vw, 0.9rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin-top: 0.4rem;
    }

    .hero-overlay { padding: 1.75rem; }
  }
</style>

