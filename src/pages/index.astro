---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allProjects = await getCollection('portfolio');
const sorted = allProjects.sort((a, b) => {
  const aDate = a.data.publishDate?.getTime() ?? 0;
  const bDate = b.data.publishDate?.getTime() ?? 0;
  return bDate - aDate;
});
---

<Layout title="Chase Fiore | Portfolio">
  <main>
    <header class="hero">
      <h1>Show Set Design<br /><span class="muted">&amp; Photography</span></h1>
    </header>

    <section class="grid-section">
      <ul class="portfolio-grid">
        {sorted.map((project) => (
          <li>
            <a href={`/portfolio/${project.id}/`} class="project-card">
              {project.data.coverImage ? (
                <div class="card-image">
                  <Image
                    src={project.data.coverImage}
                    alt={project.data.title}
                    width={800}
                    format="webp"
                    transition:name={`cover-${project.id}`}
                  />
                </div>
              ) : (
                <div class="card-image placeholder" />
              )}
              <div class="card-info">
                <h2 transition:name={`title-${project.id}`}>{project.data.title}</h2>
                {project.data.description && (
                  <p>{project.data.description}</p>
                )}
                {project.data.tags && project.data.tags.length > 0 && (
                  <ul class="tags">
                    {project.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    padding: 0 2rem 4rem;
  }

  /* ── Hero ── */
  .hero {
    padding: 5rem 0 3rem;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
  }

  .hero .muted {
    color: var(--text-muted);
  }

  /* ── Grid ── */
  .grid-section {
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }

  .portfolio-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5px;
  }

  /* ── Card ── */
  .project-card {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    aspect-ratio: 3/4;
    cursor: pointer;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0, 0, 1), filter 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .card-image.placeholder {
    background: var(--bg-card);
  }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    transform: translateY(4px);
    opacity: 0.92;
    transition: opacity 0.3s, transform 0.3s;
  }

  .card-info h2 {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .card-info p {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .tags li {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.4);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .project-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(0.7) saturate(1);
  }

  .project-card:hover .card-info {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    main {
      padding: 0 0 3rem;
    }

    .hero {
      padding: 3rem 1rem 2rem;
    }

    .grid-section {
      padding-top: 0;
      border-top: none;
    }

    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: 1px;
    }

    .project-card {
      aspect-ratio: 4/3;
    }
  }
</style>
