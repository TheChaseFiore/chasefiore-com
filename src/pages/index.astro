---
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const allProjects = await getCollection('portfolio');
const sorted = allProjects.sort((a, b) => {
  const aDate = a.data.publishDate?.getTime() ?? 0;
  const bDate = b.data.publishDate?.getTime() ?? 0;
  return bDate - aDate;
});

// Glob all portfolio images at build time so we can feed them to the hover preview
const allImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/portfolio/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const projectPreviewUrls: Record<string, string[]> = {};
for (const project of sorted) {
  const imgs = Object.entries(allImageModules)
    .filter(([path]) => path.includes(`/portfolio/${project.id}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);

  const processed = await Promise.all(
    imgs.slice(0, 8).map(img => getImage({ src: img, width: 1400, format: 'webp' }))
  );
  projectPreviewUrls[project.id] = processed.map(r => r.src);
}
---

<Layout title="Chase Fiore | Show Set Design & Photography">

  <!--
    Structure: .hero-pin creates the scroll distance.
    .hero is sticky inside it so it stays fixed while you scroll through .hero-pin.
    The grid section rises up from underneath as the hero fades.
  -->
  <div class="hero-pin">
    <section class="hero">
      <ModelViewer modelUrl="https://assets.chasefiore.com/models/SSE-draco.glb" height="100%" autoRotate={true}>
        <div class="hero-overlay">
          <div class="hero-text">
            <h1>Chase Fiore</h1>
            <p>Show Set Design &amp; Photography</p>
          </div>
          <div class="scroll-cue" aria-hidden="true">
            <span>Selected Works</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </div>
        </div>
      </ModelViewer>
    </section>
  </div>

  <!-- Grid rises up from below as hero fades -->
  <section class="grid-section" id="work">
    <div id="tag-filter-bar" class="tag-filter-bar" hidden>
      <span class="filter-label">Filtering by</span>
      <span id="active-tag-name" class="filter-tag"></span>
      <button id="clear-tag-filter" class="filter-clear" aria-label="Clear filter">✕ Clear</button>
    </div>
    <ul class="portfolio-grid">
      {sorted.map((project) => (
        <li>
          <a href={`/portfolio/${project.id}/`} class="project-card"
             data-images={JSON.stringify(projectPreviewUrls[project.id] ?? [])}
             data-title={project.data.title}
             data-tags={project.data.tags?.join('|') ?? ''}>
            {project.data.coverImage ? (
              <div class="card-image">
                <Image
                  src={project.data.coverImage}
                  alt={project.data.title}
                  width={800}
                  format="webp"
                  transition:name={`cover-${project.id}`}
                />
              </div>
            ) : (
              <div class="card-image placeholder" />
            )}
            <div class="card-info">
              <h2 transition:name={`title-${project.id}`}>{project.data.title}</h2>
              {project.data.description && <p>{project.data.description}</p>}
              {project.data.tags && project.data.tags.length > 0 && (
                <ul class="tags">
                  {project.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Hover preview overlay -->
  <div id="card-preview" aria-hidden="true">
    <img id="preview-img-a" class="preview-img" alt="" />
    <img id="preview-img-b" class="preview-img" alt="" />
    <div id="preview-title" class="preview-title"></div>
    <div id="preview-dots" class="preview-dots"></div>
  </div>

</Layout>

<script>
  // ── Scroll-driven hero fade ─────────────────────────────────────
  // The hero is sticky inside .hero-pin (height = 2× viewport).
  // As you scroll through the extra viewport-height of .hero-pin,
  // the model fades + zooms out and the grid rises up to meet you.

  type Cleanup = () => void;
  let scrollCleanup: Cleanup | null = null;

  function initScrollEffect(): Cleanup {
    const pin      = document.querySelector<HTMLElement>('.hero-pin');
    const viewer   = document.querySelector<HTMLElement>('.hero .viewer-root');
    const overlay  = document.querySelector<HTMLElement>('.hero-overlay');
    const grid     = document.querySelector<HTMLElement>('.grid-section');

    if (!pin || !viewer || !grid) return () => {};

    // The scrollable distance = extra height added to .hero-pin beyond 1 viewport
    const navH      = 64; // matches --nav-height
    const heroH     = window.innerHeight - navH;
    const scrollDist = heroH; // 1 full viewport of scroll to fade

    let raf = 0;

    function update() {
      const scrollY = window.scrollY;
      // Raw progress: 0 when at top, 1 when scrolled scrollDist past the pin top
      const pinTop = pin!.offsetTop;
      const raw = Math.min(Math.max((scrollY - pinTop) / scrollDist, 0), 1);

      // Drive the 3D explode animation with raw (unsmoothed) progress so each
      // ExplodePart can apply its own easing and stagger timing independently.
      viewer!.dispatchEvent(new CustomEvent('viewer:explode', { detail: raw }));

      // Ease: smooth-step so the start/end feel natural
      const t = raw * raw * (3 - 2 * raw);

      // Viewer: fade + zoom out (scale down slightly)
      viewer!.style.opacity  = String(1 - t);
      viewer!.style.transform = `scale(${1 - t * 0.07}) translateZ(0)`;

      // Overlay text: fades out faster so it clears before grid arrives
      if (overlay) {
        const textT = Math.min(raw / 0.45, 1);
        overlay.style.opacity = String(1 - textT * textT * (3 - 2 * textT));
      }

      // Grid: rises up from 48px below, fully settled when hero is half-faded
      const gridT = Math.min(Math.max((raw - 0.15) / 0.6, 0), 1);
      const gridEased = gridT * gridT * (3 - 2 * gridT);
      grid!.style.transform = `translateY(${(1 - gridEased) * 48}px)`;
    }

    function onScroll() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    update();

    return () => {
      window.removeEventListener('scroll', onScroll);
      cancelAnimationFrame(raf);
      // Reset transforms so navigating back looks clean
      viewer!.style.opacity = '';
      viewer!.style.transform = '';
      if (overlay) overlay.style.opacity = '';
      grid!.style.transform = '';
    };
  }

  document.addEventListener('astro:page-load', () => {
    scrollCleanup?.();
    scrollCleanup = initScrollEffect();
    initCardPreview();
    initTagFilter();
  });

  document.addEventListener('astro:before-swap', () => {
    scrollCleanup?.();
    scrollCleanup = null;
    destroyCardPreview();
  });

  scrollCleanup = initScrollEffect();
  initCardPreview();
  initTagFilter();

  window.addEventListener('popstate', initTagFilter);

  // ── Tag filtering ───────────────────────────────────────────────
  function initTagFilter() {
    const tag   = new URLSearchParams(location.search).get('tag');
    const bar   = document.getElementById('tag-filter-bar') as HTMLElement | null;
    const label = document.getElementById('active-tag-name');
    const items = document.querySelectorAll<HTMLElement>('.portfolio-grid > li');

    if (tag) {
      if (bar)   { bar.removeAttribute('hidden'); }
      if (label) { label.textContent = tag; }
      items.forEach(li => {
        const tags = li.querySelector<HTMLAnchorElement>('.project-card')?.dataset.tags ?? '';
        li.style.display = tags.split('|').includes(tag) ? '' : 'none';
      });
    } else {
      if (bar) { bar.setAttribute('hidden', ''); }
      items.forEach(li => { li.style.display = ''; });
    }

    document.getElementById('clear-tag-filter')?.addEventListener('click', () => {
      const url = new URL(location.href);
      url.searchParams.delete('tag');
      history.pushState({}, '', url);
      initTagFilter();
    });
  }

  // ── Card hover preview ──────────────────────────────────────────
  let previewCleanup: (() => void) | null = null;

  function destroyCardPreview() {
    previewCleanup?.();
    previewCleanup = null;
  }

  function initCardPreview() {
    const panel   = document.getElementById('card-preview') as HTMLElement | null;
    const imgA    = document.getElementById('preview-img-a') as HTMLImageElement | null;
    const imgB    = document.getElementById('preview-img-b') as HTMLImageElement | null;
    const titleEl = document.getElementById('preview-title') as HTMLElement | null;
    const dotsEl  = document.getElementById('preview-dots') as HTMLElement | null;
    if (!panel || !imgA || !imgB) return;
    const safePanel = panel;

    let images: string[]    = [];
    let currentIdx          = 0;
    let activeImg: HTMLImageElement = imgA;
    let inactiveImg: HTMLImageElement = imgB;
    let cycleTimer          = 0;
    let hideTimer           = 0;
    let isVisible           = false;

    function swap(nextSrc: string) {
      inactiveImg.src = nextSrc;
      inactiveImg.style.opacity = '0';

      const onReady = () => {
        // crossfade
        activeImg.style.opacity = '0';
        inactiveImg.style.opacity = '1';
        // swap references
        [activeImg, inactiveImg] = [inactiveImg, activeImg];
        updateDots();
      };

      if (inactiveImg.complete && inactiveImg.naturalWidth > 0) {
        onReady();
      } else {
        inactiveImg.onload = onReady;
      }
    }

    function advance() {
      currentIdx = (currentIdx + 1) % images.length;
      swap(images[currentIdx]);
    }

    function updateDots() {
      if (!dotsEl) return;
      dotsEl.innerHTML = images.map((_, i) =>
        `<span class="preview-dot${i === currentIdx ? ' active' : ''}"></span>`
      ).join('');
    }

    function show(srcs: string[], title: string) {
      clearTimeout(hideTimer);
      clearInterval(cycleTimer);

      images = srcs;
      currentIdx = 0;

      if (titleEl) titleEl.textContent = title;

      // Load first image into active slot immediately
      activeImg.src = srcs[0];
      activeImg.style.opacity = '1';
      inactiveImg.style.opacity = '0';
      updateDots();

      safePanel.classList.add('active');
      safePanel.setAttribute('aria-hidden', 'false');
      isVisible = true;

      // Preload all images
      srcs.forEach(src => { const i = new Image(); i.src = src; });

      if (srcs.length > 1) {
        cycleTimer = window.setInterval(advance, 2000);
      }
    }

    function hide() {
      clearInterval(cycleTimer);
      safePanel.classList.remove('active');
      safePanel.setAttribute('aria-hidden', 'true');
      isVisible = false;
      hideTimer = window.setTimeout(() => {
        // Reset after transition
        activeImg.src = '';
        inactiveImg.src = '';
      }, 400);
    }

    const cards = document.querySelectorAll<HTMLAnchorElement>('.project-card');

    const onEnter = (e: Event) => {
      const card = e.currentTarget as HTMLAnchorElement;
      const srcs: string[] = JSON.parse(card.dataset.images ?? '[]');
      const title = card.dataset.title ?? '';
      if (srcs.length === 0) return;
      show(srcs, title);
    };

    const onLeave = () => hide();

    cards.forEach(card => {
      card.addEventListener('mouseenter', onEnter);
      card.addEventListener('mouseleave', onLeave);
    });

    previewCleanup = () => {
      cards.forEach(card => {
        card.removeEventListener('mouseenter', onEnter);
        card.removeEventListener('mouseleave', onLeave);
      });
      clearInterval(cycleTimer);
      clearTimeout(hideTimer);
      if (isVisible) hide();
    };
  }
</script>

<style>
  /* ── Hero pin: creates the scroll distance for the sticky fade ── */
  .hero-pin {
    /* 2× viewport = 1 viewport of hero + 1 viewport of scroll to fade it */
    height: calc((100dvh - var(--nav-height)) * 2);
    position: relative;
  }

  .hero {
    position: sticky;
    top: var(--nav-height);
    height: calc(100dvh - var(--nav-height));
    will-change: opacity, transform;
  }

  /* ── Hero overlay ── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(12, 12, 12, 0.72) 0%,
      rgba(12, 12, 12, 0.1) 45%,
      transparent 70%
    );
    will-change: opacity;
  }

  .hero-text { margin-bottom: 1.5rem; }

  .hero-text h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }

  .hero-text p {
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0.4rem;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    animation: cue-bob 2s ease-in-out infinite;
  }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(4px); }
  }

  /* ── Tag filter bar ── */
  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.25rem;
    background: rgba(200, 168, 122, 0.06);
    border-bottom: 1px solid rgba(200, 168, 122, 0.2);
  }

  .filter-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filter-tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.5);
    padding: 0.1rem 0.5rem;
    border-radius: 2px;
  }

  .filter-clear {
    margin-left: auto;
    background: none;
    border: none;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    transition: color 0.2s;
  }

  .filter-clear:hover { color: var(--accent); }

  /* ── Grid: starts offset, JS animates it up ── */
  .grid-section {
    position: relative;
    z-index: 2;
    background: var(--bg);
    will-change: transform;
  }

  .portfolio-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5px;
  }

  /* ── Card ── */
  .project-card {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    aspect-ratio: 4/5;
    cursor: pointer;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0, 0, 1), filter 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .card-image.placeholder { background: var(--bg-card); }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.9rem;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    opacity: 0.92;
    transform: translateY(4px);
    transition: opacity 0.3s, transform 0.3s;
  }

  .card-info h2 {
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .card-info p {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .tags li {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.4);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .project-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(0.7) saturate(1);
  }

  .project-card:hover .card-info {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .portfolio-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 750px) {
    .portfolio-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 500px) {
    .hero-overlay { padding: 1.75rem; }
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 1px; }
  }

  /* ── Card hover preview ── */
  #card-preview {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #card-preview.active { opacity: 1; }

  .preview-img {
    position: absolute;
    inset: 2rem;
    width: calc(100% - 4rem);
    height: calc(100% - 4rem);
    object-fit: contain;
    transition: opacity 0.5s ease;
  }

  .preview-title {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    pointer-events: none;
  }

  .preview-dots {
    position: absolute;
    bottom: 3.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    pointer-events: none;
  }

  :global(.preview-dot) {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: background 0.3s;
  }

  :global(.preview-dot.active) {
    background: var(--accent);
  }

  @media (hover: none) {
    #card-preview { display: none; }
  }
</style>
