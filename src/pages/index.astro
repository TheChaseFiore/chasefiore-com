---
import Layout from '../layouts/Layout.astro';
import ModelViewer from '../components/ModelViewer.astro';
import { SITE_NAME, TAGLINE } from '../config';
---

<Layout title={`${SITE_NAME} | ${TAGLINE}`}>

  <!--
    Structure: .hero-pin creates the scroll distance.
    .hero is sticky inside it so it stays fixed while you scroll through .hero-pin.
    The grid section rises up from underneath as the hero fades.
  -->
  <div class="hero-pin">
    <section class="hero">
      <ModelViewer
        modelUrl="/models/landing/SSE-draco.glb"
        height="100%"
        autoRotate={true}
        navArrows={true}
        mouseTilt={true}
        cameraPos={[-1.88, 1.31, -3.15]}
        cameraTgt={[-0.49, 0.12, 0.08]}
        sectionCuts={true}
        cycleModels={[
          {url: '/models/landing/Streetcar-draco.glb', cameraPos: [-2.94, 0.42, 1.03], cameraTgt: [0.56, 0.56, 0.67], portfolioUrl: '/portfolio/scad_themed_entertainment_design/streetcar/', name: 'A Streetcar Named Desire'},
          {url: '/models/landing/Charlie_Brown-draco.glb', cameraPos: [4.58, 2.40, 5.21], cameraTgt: [1.25, 0.84, 0.31], portfolioUrl: '/portfolio/volunteer/youre-a-good-man-charlie-brown/', name: "You're a Good Man, Charlie Brown"},
          {url: '/models/landing/Coffee_Shop-draco.glb', cameraPos: [-1.59, 1.17, 5.09], cameraTgt: [-2.66, 0.83, 1.52], portfolioUrl: '/portfolio/scad_themed_entertainment_design/interior-design/', initialCutZ: 95, name: 'Interior Design Study'},
          {url: '/models/landing/SSE-draco.glb', cameraPos: [-1.88, 1.31, -3.15], cameraTgt: [-0.49, 0.12, 0.08], portfolioUrl: '/portfolio/scad_themed_entertainment_design/spaceship-earth-scad/', name: 'Spaceship Earth'},
        ]}
      >
        <div class="hero-overlay">
          <a href="/portfolio/scad_themed_entertainment_design/spaceship-earth-scad/" class="portfolio-cta" id="model-cta" aria-label="View project in portfolio">
            <span class="cta-label">View Project <span class="cta-arrow">↗</span></span>
            <span class="cta-name" id="cta-model-name">Spaceship Earth</span>
          </a>
          <div class="hero-text">
            <svg class="hero-name-svg" viewBox="0 0 600 108" xmlns="http://www.w3.org/2000/svg" aria-label="Chase Fiore" role="img">
              <text x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3" fill="rgba(255,255,255,0.92)">Chase Fiore</text>
            </svg>
            <p>{TAGLINE}</p>
          </div>
        </div>
      </ModelViewer>

      <div class="hero-name-mobile" aria-hidden="true">
        <svg class="hero-name-svg" viewBox="0 0 600 108" xmlns="http://www.w3.org/2000/svg" aria-label="Chase Fiore">
          <text x="0" y="92" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="90" letter-spacing="-3" fill="rgba(255,255,255,0.92)">Chase Fiore</text>
        </svg>
        <p>{TAGLINE}</p>
      </div>
    </section>
  </div>
</Layout>


<style>
  /* ── Hero layout ── */
  .hero-pin {
    height: calc(100dvh - var(--nav-height));
    overflow: clip;
  }

  .hero {
    height: 100%;
  }

  /* ── Hero overlay ── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 11;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem 3rem;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(12, 12, 12, 0.72) 0%,
      rgba(12, 12, 12, 0.1) 45%,
      transparent 70%
    );
  }

  .hero-text { margin-bottom: 1.5rem; }

  /* SVG stroke-animated name */
  .hero-name-svg {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    overflow: visible;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 2px 16px rgba(0,0,0,0.75));
  }

  .hero-text p {
    font-size: clamp(0.75rem, 1.2vw, 0.9rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0;
  }

  /* ── Mobile name (below model) ── */
  .hero-name-mobile {
    display: none;
  }

  @media (max-width: 600px) {
    .hero {
      display: flex;
      flex-direction: column;
    }

    .hero .viewer-root {
      flex: 1;
      min-height: 0;
      height: auto !important;
    }

    .hero-text {
      display: none;
    }

    .hero-name-mobile {
      display: block;
      flex-shrink: 0;
      padding: 1rem 1.75rem 1.25rem;
      background: var(--bg);
    }

    .hero-name-mobile p {
      font-size: clamp(0.75rem, 3.5vw, 0.9rem);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin-top: 0.4rem;
    }

    .hero-overlay { padding: 1.75rem; }
    .portfolio-cta { top: 1.75rem; left: 1.75rem; }
  }
  /* ── Portfolio CTA button ── */
  .portfolio-cta {
    position: absolute;
    top: 2.5rem;
    left: 3rem;
    pointer-events: auto;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    padding: 0.6rem 1.25rem;
    border: 1px solid rgba(200, 168, 122, 0.45);
    background: rgba(12, 12, 12, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
    box-shadow:
      0 0 18px rgba(200, 168, 122, 0.13),
      0 0 48px rgba(200, 168, 122, 0.06);
  }

  .portfolio-cta:hover {
    background: rgba(200, 168, 122, 0.1);
    border-color: rgba(200, 168, 122, 0.72);
    box-shadow:
      0 0 24px rgba(200, 168, 122, 0.24),
      0 0 64px rgba(200, 168, 122, 0.12);
  }

  .cta-label {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.3s;
  }

  .portfolio-cta:hover .cta-label {
    color: rgba(255, 255, 255, 0.75);
  }

  .cta-name {
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--accent);
    transition: color 0.3s, letter-spacing 0.25s;
  }

  .portfolio-cta:hover .cta-name {
    color: #fff;
    letter-spacing: 0.04em;
  }

  .cta-arrow {
    font-size: 0.9em;
    transition: transform 0.25s;
    display: inline-block;
  }

  .portfolio-cta:hover .cta-arrow {
    transform: translate(2px, -2px);
  }
</style>

<script>
  function initModelCta() {
    const viewer = document.querySelector<HTMLElement>('.viewer-root');
    const cta = document.getElementById('model-cta') as HTMLAnchorElement | null;
    const nameEl = document.getElementById('cta-model-name');
    if (!viewer || !cta || !nameEl) return;
    viewer.addEventListener('modelchange', (e: Event) => {
      const { portfolioUrl, name } = (e as CustomEvent<{portfolioUrl: string, name: string}>).detail;
      if (portfolioUrl) cta.href = portfolioUrl;
      if (name) nameEl.textContent = name;
    });
  }
  document.addEventListener('astro:page-load', initModelCta);
  initModelCta();
</script>

