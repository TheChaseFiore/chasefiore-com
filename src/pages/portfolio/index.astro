---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const CATEGORY_LABELS: Record<string, string> = {
  disney_live_entertainment: 'Disney Live Entertainment',
  falcons_creative_group: "Falcon's Creative Group",
  scad_themed_entertainment_design: 'SCAD: Themed Entertainment',
  universal_creative: 'Universal Creative',
  volunteer: 'Volunteer',
};

const CATEGORY_ORDER = [
  'disney_live_entertainment',
  'universal_creative',
  'scad_themed_entertainment_design',
  'falcons_creative_group',
  'volunteer',
];

const allProjects = await getCollection('portfolio');
const sorted = allProjects.sort((a, b) => {
  const aDate = a.data.publishDate?.getTime() ?? 0;
  const bDate = b.data.publishDate?.getTime() ?? 0;
  return bDate - aDate;
});

const presentCategories = CATEGORY_ORDER.filter(cat =>
  sorted.some(p => p.id.startsWith(cat + '/'))
);

const allImageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/portfolio/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const projectPreviewUrls: Record<string, string[]> = {};
for (const project of sorted) {
  const imgs = Object.entries(allImageModules)
    .filter(([path]) => path.includes(`/portfolio/${project.id}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);

  const processed = await Promise.all(
    imgs.slice(0, 8).map(img => getImage({ src: img, width: 1400, format: 'webp' }))
  );
  projectPreviewUrls[project.id] = processed.map(r => r.src);
}
---

<Layout title="Chase Fiore | Selected Works">
  <section class="grid-section" id="work">
    <!-- Category navigation -->
    <div class="category-nav" role="tablist" aria-label="Filter by employer">
      <button class="cat-tab" data-category="" role="tab">All</button>
      {presentCategories.map(cat => (
        <button class="cat-tab" data-category={cat} role="tab">
          {CATEGORY_LABELS[cat] ?? cat}
        </button>
      ))}
    </div>

    <!-- Tag filter bar (shown when filtering by tag) -->
    <div id="tag-filter-bar" class="tag-filter-bar" hidden>
      <span class="filter-label">Filtering by tag</span>
      <span id="active-tag-name" class="filter-tag"></span>
      <button id="clear-tag-filter" class="filter-clear" aria-label="Clear filter">✕ Clear</button>
    </div>

    <ul class="portfolio-grid">
      {sorted.map((project) => (
        <li data-category={project.id.split('/')[0]}>
          <a href={`/portfolio/${project.id}/`} class="project-card"
             data-images={JSON.stringify(projectPreviewUrls[project.id] ?? [])}
             data-title={project.data.title}
             data-tags={project.data.tags?.join('|') ?? ''}>
            {project.data.coverImage ? (
              <div class="card-image">
                <Image
                  src={project.data.coverImage}
                  alt={project.data.title}
                  width={800}
                  format="webp"
                  transition:name={`cover-${project.id}`}
                />
              </div>
            ) : (
              <div class="card-image placeholder" />
            )}
            <div class="card-info">
              <h2 transition:name={`title-${project.id}`}>{project.data.title}</h2>
              {project.data.description && <p>{project.data.description}</p>}
              {project.data.tags && project.data.tags.length > 0 && (
                <ul class="tags">
                  {project.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Hover preview overlay -->
  <div id="card-preview" aria-hidden="true">
    <img id="preview-img-a" class="preview-img" alt="" />
    <img id="preview-img-b" class="preview-img" alt="" />
    <div id="preview-title" class="preview-title"></div>
    <div id="preview-dots" class="preview-dots"></div>
  </div>
</Layout>

<script>
  // ── Shared visibility ───────────────────────────────────────────
  function applyVisibility() {
    const params = new URLSearchParams(location.search);
    const cat = params.get('category');
    const tag = params.get('tag');
    document.querySelectorAll<HTMLElement>('.portfolio-grid > li').forEach(li => {
      const matchesCat = !cat || li.dataset.category === cat;
      const tags = li.querySelector<HTMLAnchorElement>('.project-card')?.dataset.tags ?? '';
      const matchesTag = !tag || tags.split('|').includes(tag);
      li.style.display = (matchesCat && matchesTag) ? '' : 'none';
    });
  }

  // ── Filter animation ────────────────────────────────────────────
  async function animateFilter(commit: () => void) {
    const grid = document.querySelector<HTMLElement>('.portfolio-grid');
    if (!grid) { commit(); applyVisibility(); return; }

    grid.classList.add('is-filtering');
    await new Promise<void>(res => setTimeout(res, 180));

    commit();
    applyVisibility();

    const visible = [...document.querySelectorAll<HTMLElement>('.portfolio-grid > li')]
      .filter(li => li.style.display !== 'none');
    visible.forEach((li, i) => {
      li.classList.remove('card-entering');
      void li.offsetWidth;
      li.style.setProperty('--entry-delay', `${Math.min(i * 28, 320)}ms`);
      li.classList.add('card-entering');
    });

    grid.classList.remove('is-filtering');
    setTimeout(() => visible.forEach(li => li.classList.remove('card-entering')), 800);
  }

  // ── Sync active tab states ──────────────────────────────────────
  function syncTabs() {
    const cat = new URLSearchParams(location.search).get('category') ?? '';
    document.querySelectorAll<HTMLButtonElement>('.cat-tab').forEach(tab => {
      const match = (tab.dataset.category ?? '') === cat;
      tab.classList.toggle('active', match);
      tab.setAttribute('aria-selected', String(match));
    });
  }

  // ── Sync tag filter bar ─────────────────────────────────────────
  function syncTagBar() {
    const tag   = new URLSearchParams(location.search).get('tag');
    const bar   = document.getElementById('tag-filter-bar') as HTMLElement | null;
    const label = document.getElementById('active-tag-name');
    if (tag) {
      bar?.removeAttribute('hidden');
      if (label) label.textContent = tag;
    } else {
      bar?.setAttribute('hidden', '');
    }
  }

  // ── Init (bind events + apply initial state) ────────────────────
  function init() {
    syncTabs();
    syncTagBar();
    applyVisibility();

    document.querySelectorAll<HTMLButtonElement>('.cat-tab').forEach(tab => {
      tab.onclick = () => {
        animateFilter(() => {
          const url = new URL(location.href);
          if (tab.dataset.category) {
            url.searchParams.set('category', tab.dataset.category);
          } else {
            url.searchParams.delete('category');
          }
          url.searchParams.delete('tag');
          history.pushState({}, '', url);
          syncTabs();
          syncTagBar();
        });
      };
    });

    const clearBtn = document.getElementById('clear-tag-filter');
    if (clearBtn) {
      clearBtn.onclick = () => {
        animateFilter(() => {
          const url = new URL(location.href);
          url.searchParams.delete('tag');
          history.pushState({}, '', url);
          syncTagBar();
        });
      };
    }
  }

  // ── Card hover preview ──────────────────────────────────────────
  let previewCleanup: (() => void) | null = null;

  function destroyCardPreview() {
    previewCleanup?.();
    previewCleanup = null;
  }

  function initCardPreview() {
    const panel   = document.getElementById('card-preview') as HTMLElement | null;
    const imgA    = document.getElementById('preview-img-a') as HTMLImageElement | null;
    const imgB    = document.getElementById('preview-img-b') as HTMLImageElement | null;
    const titleEl = document.getElementById('preview-title') as HTMLElement | null;
    const dotsEl  = document.getElementById('preview-dots') as HTMLElement | null;
    if (!panel || !imgA || !imgB) return;
    const safePanel = panel;

    let images: string[]    = [];
    let currentIdx          = 0;
    let activeImg: HTMLImageElement = imgA;
    let inactiveImg: HTMLImageElement = imgB;
    let cycleTimer          = 0;
    let hideTimer           = 0;
    let showTimer           = 0;
    let isVisible           = false;

    function swap(nextSrc: string) {
      inactiveImg.src = nextSrc;
      inactiveImg.style.opacity = '0';

      const onReady = () => {
        activeImg.style.opacity = '0';
        inactiveImg.style.opacity = '1';
        [activeImg, inactiveImg] = [inactiveImg, activeImg];
        updateDots();
      };

      if (inactiveImg.complete && inactiveImg.naturalWidth > 0) {
        onReady();
      } else {
        inactiveImg.onload = onReady;
      }
    }

    function advance() {
      currentIdx = (currentIdx + 1) % images.length;
      swap(images[currentIdx]);
    }

    function updateDots() {
      if (!dotsEl) return;
      dotsEl.innerHTML = images.map((_, i) =>
        `<span class="preview-dot${i === currentIdx ? ' active' : ''}"></span>`
      ).join('');
    }

    function show(srcs: string[], title: string) {
      clearTimeout(hideTimer);
      clearInterval(cycleTimer);

      images = srcs;
      currentIdx = 0;

      if (titleEl) titleEl.textContent = title;

      activeImg.src = srcs[0];
      activeImg.style.opacity = '1';
      inactiveImg.style.opacity = '0';
      updateDots();

      safePanel.classList.add('active');
      safePanel.setAttribute('aria-hidden', 'false');
      isVisible = true;

      srcs.forEach(src => { const i = new Image(); i.src = src; });

      if (srcs.length > 1) {
        cycleTimer = window.setInterval(advance, 2000);
      }
    }

    function hide() {
      clearInterval(cycleTimer);
      safePanel.classList.remove('active');
      safePanel.setAttribute('aria-hidden', 'true');
      isVisible = false;
      hideTimer = window.setTimeout(() => {
        activeImg.src = '';
        inactiveImg.src = '';
      }, 1100);
    }

    const cards = document.querySelectorAll<HTMLAnchorElement>('.project-card');

    const onEnter = (e: Event) => {
      const card = e.currentTarget as HTMLAnchorElement;
      const srcs: string[] = JSON.parse(card.dataset.images ?? '[]');
      const title = card.dataset.title ?? '';
      if (srcs.length === 0) return;
      clearTimeout(showTimer);
      showTimer = window.setTimeout(() => show(srcs, title), 3000);
    };

    const onLeave = () => {
      clearTimeout(showTimer);
      hide();
    };

    cards.forEach(card => {
      card.addEventListener('mouseenter', onEnter);
      card.addEventListener('mouseleave', onLeave);
    });

    previewCleanup = () => {
      cards.forEach(card => {
        card.removeEventListener('mouseenter', onEnter);
        card.removeEventListener('mouseleave', onLeave);
      });
      clearTimeout(showTimer);
      clearInterval(cycleTimer);
      clearTimeout(hideTimer);
      if (isVisible) hide();
    };
  }

  document.addEventListener('astro:page-load', () => {
    init();
    initCardPreview();
  });

  document.addEventListener('astro:before-swap', destroyCardPreview);

  window.addEventListener('popstate', () => {
    syncTabs();
    syncTagBar();
    applyVisibility();
  });

  init();
  initCardPreview();
</script>

<style>
  /* ── Category nav ── */
  .category-nav {
    display: flex;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-nav::-webkit-scrollbar { display: none; }

  .cat-tab {
    background: none;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-family: var(--font);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.3rem 0.85rem;
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .cat-tab:hover {
    color: var(--text);
    border-color: var(--border);
  }

  .cat-tab.active {
    color: var(--accent);
    border-color: rgba(200, 168, 122, 0.45);
    background: rgba(200, 168, 122, 0.07);
  }

  /* ── Tag filter bar ── */
  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.25rem;
    background: rgba(200, 168, 122, 0.04);
    border-bottom: 1px solid rgba(200, 168, 122, 0.15);
  }

  .filter-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filter-tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.5);
    padding: 0.1rem 0.5rem;
    border-radius: 2px;
  }

  .filter-clear {
    margin-left: auto;
    background: none;
    border: none;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    transition: color 0.2s;
  }

  .filter-clear:hover { color: var(--accent); }

  /* ── Grid ── */
  .grid-section {
    position: relative;
    z-index: 2;
    background: var(--bg);
  }

  .portfolio-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5px;
    transition: opacity 0.18s ease;
  }

  .portfolio-grid.is-filtering {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes card-lift {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .portfolio-grid > li.card-entering {
    animation: card-lift 0.32s ease both;
    animation-delay: var(--entry-delay, 0ms);
  }

  /* ── Card ── */
  .project-card {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    aspect-ratio: 4/5;
    cursor: pointer;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0, 0, 1), filter 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .card-image.placeholder { background: var(--bg-card); }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.9rem;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    opacity: 0.92;
    transform: translateY(4px);
    transition: opacity 0.3s, transform 0.3s;
  }

  .card-info h2 {
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .card-info p {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .tags li {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200, 168, 122, 0.4);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .project-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(0.7) saturate(1);
  }

  .project-card:hover .card-info {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .portfolio-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 750px) {
    .portfolio-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 500px) {
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); gap: 1px; }
    .category-nav { padding: 0.6rem 0.75rem; gap: 0.3rem; }
    .cat-tab { font-size: 0.62rem; padding: 0.25rem 0.65rem; }
  }

  /* ── Card hover preview ── */
  #card-preview {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    transition: opacity 3s ease;
    background: rgba(8, 8, 8, 0.88);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #card-preview.active {
    opacity: 1;
    transition: opacity 1s ease;
  }

  .preview-img {
    position: absolute;
    inset: 2rem;
    width: calc(100% - 4rem);
    height: calc(100% - 4rem);
    object-fit: contain;
    transition: opacity 0.5s ease;
  }

  .preview-title {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    white-space: nowrap;
    pointer-events: none;
  }

  .preview-dots {
    position: absolute;
    bottom: 3.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    pointer-events: none;
  }

  :global(.preview-dot) {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transition: background 0.3s;
  }

  :global(.preview-dot.active) {
    background: var(--accent);
  }

  @media (hover: none) {
    #card-preview { display: none; }
  }
</style>
