---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, TAGLINE } from '../config';
---

<Layout
  title={`${SITE_NAME} | Projects`}
  description={`Personal projects by ${SITE_NAME} — photography, lighting, music, and programming.`}
>
  <main class="projects-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Personal work across photography, lighting, music, and software.</p>
    </header>

    <!-- Photography -->
    <section class="category" id="photography">
      <div class="category-label">Photography</div>
      <div class="category-grid">
        <div class="project-card photo-placeholder"></div>
        <div class="project-card photo-placeholder"></div>
        <div class="project-card photo-placeholder"></div>
        <div class="project-card photo-placeholder"></div>
      </div>
    </section>

    <!-- Lighting -->
    <section class="category" id="lighting">
      <div class="category-label">Lighting Design</div>
      <div class="category-grid">
        <div class="project-card photo-placeholder"></div>
        <div class="project-card photo-placeholder"></div>
        <div class="project-card photo-placeholder"></div>
      </div>
    </section>

    <!-- Music -->
    <section class="category" id="music">
      <div class="category-label">Music</div>
      <div class="category-grid">
        <div class="project-card music-card">
          <div class="music-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <p class="card-title">Coming soon</p>
        </div>
      </div>
    </section>

    <!-- Programming -->
    <section class="category" id="programming">
      <div class="category-label">Programming</div>
      <div class="category-grid">
        <a class="project-card code-card" href="https://github.com" target="_blank" rel="noopener noreferrer">
          <div class="code-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <p class="card-title">This site</p>
          <p class="card-sub">Astro · Three.js · WebGL</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .projects-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .page-header {
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .page-header p {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .category {
    margin-bottom: 4rem;
  }

  .category-label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    aspect-ratio: 4/3;
    overflow: hidden;
    transition: border-color 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    border-color: rgba(200, 168, 122, 0.35);
  }

  /* Photo placeholders — will be replaced with actual images */
  .photo-placeholder {
    background: linear-gradient(135deg, #141414 0%, #1a1a1a 100%);
    position: relative;
  }

  .photo-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 40%, rgba(200,168,122,0.04) 0%, transparent 65%);
  }

  /* Music / code cards */
  .music-card,
  .code-card {
    gap: 0.5rem;
    cursor: pointer;
  }

  .music-icon,
  .code-icon {
    color: rgba(200, 168, 122, 0.45);
    transition: color 0.2s;
  }

  .project-card:hover .music-icon,
  .project-card:hover .code-icon {
    color: var(--accent);
  }

  .card-title {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--text);
  }

  .card-sub {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .projects-page {
      padding: 2rem 1.25rem 4rem;
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
