---
import Layout from '../../layouts/Layout.astro';
import { SITE_NAME } from '../../config';

const audioModules = import.meta.glob('/src/content/personal_projects/audio_mastering/*.wav', {
  query: '?url',
  import: 'default',
  eager: true,
});

const tracks = Object.entries(audioModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, url], i) => ({
    name: path.split('/').pop()!.replace(/\.wav$/i, ''),
    url: url as string,
    index: i,
  }));
---

<Layout
  title={`Audio Mastering | ${SITE_NAME}`}
  description={`Audio engineering and mastering work by ${SITE_NAME}.`}
>
  <main class="audio-page">
    <div class="content-wrap">
      <nav class="breadcrumb">
        <a href="/projects/">← Projects</a>
        <span class="tag">Audio Mastering</span>
      </nav>

      <header class="page-header">
        <h1>Audio Mastering</h1>
        <p>Selected works in audio engineering and mastering.</p>
      </header>

      <!-- Player -->
      <div class="player" id="player">
        <div class="player-track">
          <span class="player-label">Now Playing</span>
          <span class="player-name" id="player-name">—</span>
        </div>
        <div class="player-controls">
          <button class="ctrl-btn" id="prev-btn" aria-label="Previous">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
          </button>
          <button class="ctrl-btn play-btn" id="play-btn" aria-label="Play">
            <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>
          <button class="ctrl-btn" id="next-btn" aria-label="Next">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm2-8.14L11.03 12 8 14.14V9.86zM16 6h2v12h-2z"/></svg>
          </button>
          <div class="progress-wrap">
            <input type="range" class="progress-bar" id="progress" min="0" max="100" value="0" step="0.1" />
          </div>
          <span class="time-display" id="time-display">0:00 / 0:00</span>
        </div>
      </div>
      <audio id="audio-el" preload="none"></audio>

      <!-- Track list -->
      <ol class="track-list" id="track-list">
        {tracks.map(track => (
          <li class="track-item" data-src={track.url} data-index={track.index}>
            <span class="track-num">{String(track.index + 1).padStart(2, '0')}</span>
            <span class="track-name">{track.name}</span>
            <button class="track-play" aria-label={`Play ${track.name}`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </main>
</Layout>

<script>
  function initPlayer() {
    const audio = document.getElementById('audio-el') as HTMLAudioElement | null;
    const playerName = document.getElementById('player-name');
    const playBtn = document.getElementById('play-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const progress = document.getElementById('progress') as HTMLInputElement | null;
    const timeDisplay = document.getElementById('time-display');
    const trackList = document.getElementById('track-list');
    if (!audio || !playBtn || !progress || !trackList) return;

    const iconPlay = playBtn.querySelector('.icon-play') as HTMLElement | null;
    const iconPause = playBtn.querySelector('.icon-pause') as HTMLElement | null;
    const items = Array.from(trackList.querySelectorAll<HTMLElement>('.track-item'));
    let currentIndex = -1;

    function fmt(s: number): string {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${sec.toString().padStart(2, '0')}`;
    }

    function setPlaying(playing: boolean) {
      if (iconPlay) iconPlay.style.display = playing ? 'none' : '';
      if (iconPause) iconPause.style.display = playing ? '' : 'none';
    }

    function loadTrack(index: number, autoplay = true) {
      const item = items[index];
      if (!item) return;
      const src = item.dataset.src ?? '';
      const name = item.querySelector('.track-name')?.textContent ?? '';
      audio!.src = src;
      if (playerName) playerName.textContent = name;
      if (progress) progress.value = '0';
      if (timeDisplay) timeDisplay.textContent = '0:00 / 0:00';
      items.forEach(el => el.classList.remove('active'));
      item.classList.add('active');
      currentIndex = index;
      if (autoplay) audio!.play().then(() => setPlaying(true)).catch(() => {});
    }

    playBtn.addEventListener('click', () => {
      if (currentIndex < 0) { loadTrack(0); return; }
      if (audio.paused) { audio.play().then(() => setPlaying(true)).catch(() => {}); }
      else { audio.pause(); setPlaying(false); }
    });

    prevBtn?.addEventListener('click', () => {
      const idx = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
      loadTrack(idx);
    });

    nextBtn?.addEventListener('click', () => {
      const idx = (currentIndex + 1) % items.length;
      loadTrack(idx);
    });

    audio.addEventListener('timeupdate', () => {
      if (!audio.duration) return;
      const pct = (audio.currentTime / audio.duration) * 100;
      if (progress) progress.value = String(pct);
      if (timeDisplay) timeDisplay.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    });

    audio.addEventListener('ended', () => {
      const idx = (currentIndex + 1) % items.length;
      loadTrack(idx);
    });

    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('play', () => setPlaying(true));

    progress.addEventListener('input', () => {
      if (audio.duration) audio.currentTime = (Number(progress.value) / 100) * audio.duration;
    });

    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        if (currentIndex === i && !audio.paused) { audio.pause(); }
        else { loadTrack(i); }
      });
    });
  }

  document.addEventListener('astro:page-load', initPlayer);
  initPlayer();
</script>

<style>
  .audio-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .content-wrap { max-width: 780px; }

  .breadcrumb {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 2.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--text-muted); transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--accent); }
  .tag {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(200,168,122,0.4);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .page-header { margin-bottom: 2.5rem; }
  .page-header h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* ── Player ── */
  .player {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 0.5rem;
  }

  .player-track {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .player-label {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    flex-shrink: 0;
  }
  .player-name {
    font-size: 0.9rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ctrl-btn {
    background: none;
    border: none;
    color: rgba(232,232,232,0.5);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s;
    flex-shrink: 0;
  }
  .ctrl-btn:hover { color: var(--text); }

  .play-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.12) !important;
    background: rgba(255,255,255,0.04) !important;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .play-btn:hover {
    background: rgba(200,168,122,0.1) !important;
    border-color: rgba(200,168,122,0.4) !important;
    color: var(--accent) !important;
  }

  .progress-wrap { flex: 1; display: flex; align-items: center; }
  .progress-bar {
    width: 100%;
    height: 2px;
    appearance: none;
    -webkit-appearance: none;
    background: rgba(255,255,255,0.1);
    border-radius: 1px;
    outline: none;
    cursor: pointer;
    accent-color: var(--accent);
  }
  .progress-bar::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    transition: transform 0.15s;
  }
  .progress-bar:hover::-webkit-slider-thumb { transform: scale(1.3); }

  .time-display {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    min-width: 90px;
    text-align: right;
  }

  /* ── Track list ── */
  .track-list {
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .track-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
  }
  .track-item:hover { background: rgba(255,255,255,0.02); }
  .track-item.active { background: rgba(200,168,122,0.05); }
  .track-item.active .track-num { color: var(--accent); }
  .track-item.active .track-name { color: var(--text); }

  .track-num {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 1.8rem;
  }
  .track-name {
    flex: 1;
    font-size: 0.875rem;
    color: rgba(232,232,232,0.75);
    transition: color 0.15s;
  }
  .track-play {
    background: none;
    border: none;
    color: rgba(255,255,255,0.25);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s;
    flex-shrink: 0;
  }
  .track-item:hover .track-play { color: var(--text-muted); }
  .track-item.active .track-play { color: var(--accent); }

  @media (max-width: 600px) {
    .audio-page { padding: 2rem 1.25rem 4rem; }
    .time-display { display: none; }
  }
</style>
