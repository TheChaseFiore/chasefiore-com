---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_NAME } from '../../config';

const lightingEntries = await getCollection('lighting-design');
const drawingEntries  = await getCollection('drawing');

// Sort both by publishDate descending
const sortByDate = (a: { data: { publishDate?: Date } }, b: { data: { publishDate?: Date } }) =>
  (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0);

const lightingSorted = lightingEntries.sort(sortByDate);
const drawingSorted  = drawingEntries.sort(sortByDate);
---

<Layout title={`${SITE_NAME} | Projects`}
        description={`Personal work by ${SITE_NAME} — lighting design, drawing, photography, music, and more.`}>
  <main class="projects-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Personal work across creative disciplines.</p>
    </header>

    {lightingSorted.length > 0 && (
      <section class="category">
        <div class="category-label">Lighting Design</div>
        <ul class="project-grid">
          {lightingSorted.map(entry => (
            <li>
              <a href={`/projects/lighting-design/${entry.id}/`} class="project-card">
                {entry.data.coverImage ? (
                  <div class="card-image">
                    <Image src={entry.data.coverImage} alt={entry.data.title} width={800} format="webp" />
                  </div>
                ) : <div class="card-image placeholder" />}
                <div class="card-info">
                  <h2>{entry.data.title}</h2>
                  {entry.data.description && <p>{entry.data.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {drawingSorted.length > 0 && (
      <section class="category">
        <div class="category-label">Drawing & Painting</div>
        <ul class="project-grid">
          {drawingSorted.map(entry => (
            <li>
              <a href={`/projects/drawing/${entry.id}/`} class="project-card">
                {entry.data.coverImage ? (
                  <div class="card-image">
                    <Image src={entry.data.coverImage} alt={entry.data.title} width={800} format="webp" />
                  </div>
                ) : <div class="card-image placeholder" />}
                <div class="card-info">
                  <h2>{entry.data.title}</h2>
                  {entry.data.description && <p>{entry.data.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Placeholder sections for content not yet in collections -->
    <section class="category">
      <div class="category-label">Photography</div>
      <p class="coming-soon">Coming soon.</p>
    </section>

    <section class="category">
      <div class="category-label">Music</div>
      <p class="coming-soon">Coming soon.</p>
    </section>

    <section class="category">
      <div class="category-label">Programming</div>
      <p class="coming-soon">Coming soon.</p>
    </section>
  </main>
</Layout>

<style>
  .projects-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .page-header p {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .category {
    margin-bottom: 3.5rem;
  }

  .category-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .coming-soon {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }

  .project-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
  }

  .project-card {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    aspect-ratio: 4/5;
    cursor: pointer;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0, 0, 1), filter 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .card-image.placeholder { background: var(--bg-card); }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.9rem;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    opacity: 0.92;
    transform: translateY(4px);
    transition: opacity 0.3s, transform 0.3s;
  }

  .card-info h2 {
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .card-info p {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(0.7) saturate(1);
  }

  .project-card:hover .card-info {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) { .project-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) {
    .projects-page { padding: 2rem 1.25rem 4rem; }
    .project-grid { grid-template-columns: repeat(2, 1fr); gap: 1px; }
  }
</style>
