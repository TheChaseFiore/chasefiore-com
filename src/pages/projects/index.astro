---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE_NAME } from '../../config';

const programingEntries = await getCollection('programing');
const drawingEntries    = await getCollection('drawing');

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/personal_projects/photography/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);
const previewPhotos = Object.entries(photoModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .slice(0, 8)
  .map(([, mod]) => mod.default);

const trackNames = [
  "1952 Vincent", "Beauty Remains", "Blue, Red, and Grey",
  "Coal Miner's Daughter", "Everything", "Good King",
  "Hearts and Bones", "It Doesn't Matter Anymore", "King of Bohemia",
  "Nashville", "Parchman Farm",
];

const sortByDate = (a: { data: { publishDate?: Date } }, b: { data: { publishDate?: Date } }) =>
  (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0);

const programingSorted = programingEntries.sort(sortByDate);
const drawingSorted    = drawingEntries.sort(sortByDate);
---

<Layout title={`${SITE_NAME} | Projects`}
        description={`Personal work by ${SITE_NAME} — programming, drawing, photography, audio mastering, and more.`}>
  <main class="projects-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Personal work across creative disciplines.</p>
    </header>

    {programingSorted.length > 0 && (
      <section class="category">
        <div class="category-label">Programming</div>
        <ul class="project-grid">
          {programingSorted.map(entry => (
            <li>
              <a href={`/projects/programing/${entry.id}/`} class="project-card">
                {entry.data.coverImage ? (
                  <div class="card-image">
                    <Image src={entry.data.coverImage} alt={entry.data.title} width={800} format="webp" />
                  </div>
                ) : <div class="card-image placeholder" />}
                <div class="card-info">
                  <h2>{entry.data.title}</h2>
                  {entry.data.description && <p>{entry.data.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {drawingSorted.length > 0 && (
      <section class="category">
        <div class="category-label">Drawing & Painting</div>
        <ul class="project-grid">
          {drawingSorted.map(entry => (
            <li>
              <a href={`/projects/drawing/${entry.id}/`} class="project-card">
                {entry.data.coverImage ? (
                  <div class="card-image">
                    <Image src={entry.data.coverImage} alt={entry.data.title} width={800} format="webp" />
                  </div>
                ) : <div class="card-image placeholder" />}
                <div class="card-info">
                  <h2>{entry.data.title}</h2>
                  {entry.data.description && <p>{entry.data.description}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="category">
      <div class="category-label">Photography</div>
      <a href="/projects/photography/" class="photo-preview-link" aria-label="View all photos">
        <div class="photo-preview-grid">
          {previewPhotos.map((src, i) => (
            <div class="preview-thumb">
              <Image src={src} alt={`Photography preview ${i + 1}`} width={400} format="webp" loading="lazy" />
            </div>
          ))}
        </div>
        <span class="section-enter">View all photos ↗</span>
      </a>
    </section>

    <section class="category">
      <div class="category-label">Audio Mastering</div>
      <ol class="preview-tracks">
        {trackNames.map((name, i) => (
          <li>
            <a href={`/projects/audio-mastering/?track=${i}`} class="preview-track">
              <span class="preview-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="preview-name">{name}</span>
            </a>
          </li>
        ))}
      </ol>
      <a href="/projects/audio-mastering/" class="section-enter">View all recordings ↗</a>
    </section>
  </main>
</Layout>

<style>
  .projects-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  .page-header p {
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .category {
    margin-bottom: 3.5rem;
  }

  .category-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .coming-soon {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }

  .section-enter {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    width: 100%;
    transition: letter-spacing 0.2s;
  }
  .section-enter:hover { letter-spacing: 0.1em; }

  /* ── Photo preview ── */
  .photo-preview-link {
    display: block;
    text-decoration: none;
  }
  .photo-preview-link:hover .section-enter { letter-spacing: 0.1em; }

  .photo-preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
    margin-bottom: 0;
  }

  .preview-thumb {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.25, 0, 0, 1), filter 0.3s;
    filter: brightness(0.88) saturate(0.9);
  }
  .photo-preview-link:hover .preview-thumb img {
    transform: scale(1.04);
    filter: brightness(1) saturate(1);
  }

  /* ── Audio track preview ── */
  .preview-tracks {
    list-style: none;
    border-top: 1px solid var(--border);
    margin-bottom: 0;
  }

  .preview-tracks li { list-style: none; }

  .preview-track {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    transition: background 0.15s;
  }
  .preview-track:hover { background: rgba(255,255,255,0.03); }
  .preview-track:hover .preview-num { color: var(--accent); }
  .preview-track:hover .preview-name { color: var(--text); }

  .preview-num {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 1.6rem;
    transition: color 0.15s;
  }

  .preview-name {
    font-size: 0.82rem;
    color: rgba(232,232,232,0.7);
    transition: color 0.15s;
  }

  .project-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
  }

  .project-card {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    aspect-ratio: 4/5;
    cursor: pointer;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0, 0, 1), filter 0.4s ease;
    filter: brightness(0.85) saturate(0.9);
  }

  .card-image.placeholder { background: var(--bg-card); }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.9rem;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    opacity: 0.92;
    transform: translateY(4px);
    transition: opacity 0.3s, transform 0.3s;
  }

  .card-info h2 {
    font-size: 0.8rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .card-info p {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card:hover .card-image img {
    transform: scale(1.04);
    filter: brightness(0.7) saturate(1);
  }

  .project-card:hover .card-info {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .project-grid { grid-template-columns: repeat(3, 1fr); }
    .photo-preview-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 600px) {
    .projects-page { padding: 2rem 1.25rem 4rem; }
    .project-grid { grid-template-columns: repeat(2, 1fr); gap: 1px; }
    .photo-preview-grid { grid-template-columns: repeat(4, 1fr); gap: 1px; }
  }
</style>
