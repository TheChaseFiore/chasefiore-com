---
interface Props {
  modelUrl?: string;   // path to GLB in public/, e.g. "/models/ministry-of-magic.glb"
  height?: string;     // CSS height value
  autoRotate?: boolean;
}

const { modelUrl = '', height = '500px', autoRotate = true } = Astro.props;
---

<div
  class="viewer-root"
  style={`height: ${height}`}
  data-model-url={modelUrl}
  data-auto-rotate={String(autoRotate)}
>
  <canvas class="viewer-canvas"></canvas>

  {modelUrl && (
    <div class="viewer-loading" aria-hidden="true">
      <svg class="loading-svg" viewBox="0 0 480 90" xmlns="http://www.w3.org/2000/svg">
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
      </svg>
      <div class="loading-bar-track">
        <div class="loading-bar-fill"></div>
      </div>
    </div>
  )}

  <slot />

  <div class="viewer-hint">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 0 1 7 7v1l2 1-2 1v3l-7 4-7-4v-3L3 10l2-1V9a7 7 0 0 1 7-7z"/><path d="M12 2v18"/></svg>
    <span>Drag to rotate</span>
  </div>
</div>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader, type GLTF } from 'three/addons/loaders/GLTFLoader.js';

type CleanupFn = () => void;
const cleanups = new Map<Element, CleanupFn>();

interface ExplodePart {
  object: THREE.Object3D;
  origin: THREE.Vector3;
  dir: THREE.Vector3;
  dist: number;
  startAt: number; // scroll raw [0–1] when this part begins moving
  endAt: number;   // scroll raw [0–1] when it reaches full displacement
}

function initAllViewers() {
  document.querySelectorAll<HTMLElement>('.viewer-root:not([data-viewer-init])').forEach(el => {
    el.setAttribute('data-viewer-init', '1');
    const cleanup = setupViewer(el);
    cleanups.set(el, cleanup);
  });
}

function setupViewer(root: HTMLElement): CleanupFn {
  const canvas = root.querySelector<HTMLCanvasElement>('.viewer-canvas')!;
  const modelUrl = root.dataset.modelUrl ?? '';
  const autoRotate = root.dataset.autoRotate !== 'false';

  // ── Scene ──────────────────────────────────────────────────────
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x0c0c0c);
  scene.fog = new THREE.FogExp2(0x0c0c0c, 0.022);

  // ── Camera ──────────────────────────────────────────────────────
  const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 200);
  camera.position.set(4.5, 5.5, 7);
  camera.lookAt(0, 3.5, 0);

  // ── Renderer ────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;

  // ── Lights ──────────────────────────────────────────────────────
  scene.add(new THREE.AmbientLight(0x120d08, 1.2));

  // Key light — warm, elevated from upper front-right
  const keyLight = new THREE.DirectionalLight(0xfff0d8, 2.5);
  keyLight.position.set(5, 14, 10);
  keyLight.castShadow = true;
  keyLight.shadow.mapSize.set(2048, 2048);
  keyLight.shadow.camera.near = 0.5;
  keyLight.shadow.camera.far = 50;
  keyLight.shadow.camera.left = -15;
  keyLight.shadow.camera.right = 15;
  keyLight.shadow.camera.top = 15;
  keyLight.shadow.camera.bottom = -8;
  scene.add(keyLight);

  // Cool fill from front-left for contrast
  const fillLight = new THREE.DirectionalLight(0x1a2d50, 0.5);
  fillLight.position.set(-10, 4, 5);
  scene.add(fillLight);

  // Warm rim light from behind — separates subject from background
  const rimLight = new THREE.DirectionalLight(0xc8a87a, 0.9);
  rimLight.position.set(-2, 7, -14);
  scene.add(rimLight);

  // Stage uplights — warm gold floor pools
  const uplightPositions = [[-4.5, 0.5, 0], [0, 0.5, 1], [4.5, 0.5, 0]] as const;
  uplightPositions.forEach(([x, y, z]) => {
    const upl = new THREE.PointLight(0xd4a870, 2.8, 10, 1.5);
    upl.position.set(x, y, z);
    scene.add(upl);
  });

  // ── Controls ────────────────────────────────────────────────────
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.06;
  controls.autoRotate = autoRotate;
  controls.autoRotateSpeed = 0.6;
  controls.maxPolarAngle = Math.PI / 2 + 0.05;
  controls.minDistance = 3;
  controls.maxDistance = 30;
  controls.target.set(0, 3.5, 0);

  // ── Scroll / touch passthrough ──────────────────────────────────
  canvas.style.touchAction = 'pan-y';

  let userInteracting = false;
  let interactTimer = 0;

  const onPointerDown = () => {
    controls.autoRotate = false;
    userInteracting = true;
    clearTimeout(interactTimer);
  };
  const onPointerUp = () => {
    interactTimer = window.setTimeout(() => { userInteracting = false; }, 1500);
  };

  canvas.addEventListener('pointerdown', onPointerDown);
  window.addEventListener('pointerup', onPointerUp);

  root.addEventListener('wheel', (e) => {
    if (!userInteracting) e.stopPropagation();
  }, { capture: true });

  // ── Explode ──────────────────────────────────────────────────────
  const explodeParts: ExplodePart[] = [];
  let explodeProgress = 0;

  const onExplode = (e: Event) => {
    explodeProgress = (e as CustomEvent<number>).detail;
  };
  root.addEventListener('viewer:explode', onExplode);

  // ── Loading overlay ──────────────────────────────────────────────
  const loadingEl = root.querySelector<HTMLElement>('.viewer-loading');

  // ── Model / Placeholder ─────────────────────────────────────────
  if (modelUrl) {
    const loader = new GLTFLoader();
    loader.load(
      modelUrl,
      (gltf: GLTF) => {
        const model = gltf.scene;
        const box = new THREE.Box3().setFromObject(model);
        const center = box.getCenter(new THREE.Vector3());
        const size = box.getSize(new THREE.Vector3());
        const maxDim = Math.max(size.x, size.y, size.z);
        const scale = 8 / maxDim;
        model.scale.setScalar(scale);
        model.position.sub(center.multiplyScalar(scale));
        model.position.y += (size.y * scale) / 2;
        model.traverse((child: THREE.Object3D) => {
          if ((child as THREE.Mesh).isMesh) {
            child.castShadow = true;
            child.receiveShadow = true;
          }
        });
        scene.add(model);

        // Generic explode: push each top-level child away from model centre
        if (model.children.length > 1) {
          const modelCenter = new THREE.Box3().setFromObject(model).getCenter(new THREE.Vector3());
          model.children.forEach((child, idx) => {
            const childCenter = new THREE.Box3().setFromObject(child).getCenter(new THREE.Vector3());
            const dir = childCenter.clone().sub(modelCenter);
            const spread = dir.length();
            dir.normalize();
            if (dir.lengthSq() < 0.001) {
              const a = (idx / model.children.length) * Math.PI * 2;
              dir.set(Math.cos(a), 0.5, Math.sin(a)).normalize();
            }
            explodeParts.push({ object: child, origin: child.position.clone(), dir, dist: Math.max(spread * 4, 8), startAt: 0.05, endAt: 0.75 });
          });
        }

        // Dismiss loading overlay
        if (loadingEl) {
          loadingEl.classList.add('is-loaded');
          loadingEl.addEventListener('transitionend', () => loadingEl.remove(), { once: true });
        }
      },
      (event: ProgressEvent) => {
        if (event.lengthComputable && loadingEl) {
          const bar = loadingEl.querySelector<HTMLElement>('.loading-bar-fill');
          if (bar) bar.style.width = `${(event.loaded / event.total) * 100}%`;
        }
      }
    );
  } else {
    if (loadingEl) loadingEl.remove();
    explodeParts.push(...buildPlaceholder(scene));
  }

  // ── Resize ──────────────────────────────────────────────────────
  function resize() {
    const w = root.clientWidth;
    const h = root.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h, false);
  }
  resize();
  const ro = new ResizeObserver(resize);
  ro.observe(root);

  // ── Loop ────────────────────────────────────────────────────────
  let rafId = 0;
  function tick() {
    rafId = requestAnimationFrame(tick);
    controls.update();

    if (explodeProgress > 0.001 && explodeParts.length > 0) {
      for (const p of explodeParts) {
        const local = Math.min(Math.max((explodeProgress - p.startAt) / (p.endAt - p.startAt), 0), 1);
        const eased = local * local * (3 - 2 * local);
        p.object.position.copy(p.origin).addScaledVector(p.dir, p.dist * eased);
      }
    }

    renderer.render(scene, camera);
  }
  tick();

  // ── Cleanup ─────────────────────────────────────────────────────
  return () => {
    cancelAnimationFrame(rafId);
    ro.disconnect();
    controls.dispose();
    renderer.dispose();
    canvas.removeEventListener('pointerdown', onPointerDown);
    window.removeEventListener('pointerup', onPointerUp);
    root.removeEventListener('viewer:explode', onExplode);
    clearTimeout(interactTimer);
    for (const p of explodeParts) p.object.position.copy(p.origin);
    root.removeAttribute('data-viewer-init');
  };
}

// ── Placeholder stage geometry ────────────────────────────────────
function buildPlaceholder(scene: THREE.Scene): ExplodePart[] {
  const accent   = 0xc8a87a;
  const darkWood = 0x1a1410;
  const midWood  = 0x242018;
  const floor    = 0x0f0f0f;

  const accentMat = new THREE.MeshStandardMaterial({ color: accent,   metalness: 0.4, roughness: 0.5 });
  const darkMat   = new THREE.MeshStandardMaterial({ color: darkWood, roughness: 0.9 });
  const midMat    = new THREE.MeshStandardMaterial({ color: midWood,  roughness: 0.85 });
  const floorMat  = new THREE.MeshStandardMaterial({ color: floor,    roughness: 1.0 });
  const edgeMat   = new THREE.LineBasicMaterial({ color: 0x3a2e1e, transparent: true, opacity: 0.55 });

  function addEdges(mesh: THREE.Mesh, parent: THREE.Group) {
    const edges = new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry, 12), edgeMat.clone());
    edges.position.copy(mesh.position);
    edges.rotation.copy(mesh.rotation);
    edges.scale.copy(mesh.scale);
    parent.add(edges);
  }

  const flyGroup = new THREE.Group();
  const batten = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 12, 6), accentMat);
  batten.rotation.z = Math.PI / 2;
  batten.position.set(0, 6.6, -1.6);
  flyGroup.add(batten);
  for (let i = -5; i <= 5; i += 2.5) {
    const line = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 5, 4), darkMat);
    line.position.set(i, 4.6, -1.6);
    flyGroup.add(line);
  }
  scene.add(flyGroup);

  const backGroup = new THREE.Group();
  const backWall = new THREE.Mesh(new THREE.BoxGeometry(13, 7.5, 0.28), darkMat);
  backWall.position.set(0, 3.75, -5);
  backWall.castShadow = true;
  backGroup.add(backWall);
  addEdges(backWall, backGroup);
  for (let i = 0; i < 4; i++) {
    const x = -4.5 + i * 3;
    const col = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.16, 7, 10), midMat);
    col.position.set(x, 3.5, -4.87);
    col.castShadow = true;
    backGroup.add(col);
    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.18, 0.44), accentMat);
    cap.position.set(x, 7.09, -4.87);
    backGroup.add(cap);
    const base = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.18, 0.44), accentMat);
    base.position.set(x, -0.04, -4.87);
    backGroup.add(base);
  }
  scene.add(backGroup);

  const floorGroup = new THREE.Group();
  const ground = new THREE.Mesh(new THREE.BoxGeometry(28, 0.08, 22), floorMat);
  ground.position.y = -0.04;
  ground.receiveShadow = true;
  floorGroup.add(ground);
  const gridHelper = new THREE.GridHelper(26, 26, 0x1c1c1c, 0x161616);
  gridHelper.position.y = 0.02;
  floorGroup.add(gridHelper);
  scene.add(floorGroup);

  const deckGroup = new THREE.Group();
  const deck = new THREE.Mesh(new THREE.BoxGeometry(13, 0.45, 9), midMat);
  deck.position.set(0, 0.22, -0.5);
  deck.castShadow = true;
  deck.receiveShadow = true;
  deckGroup.add(deck);
  addEdges(deck, deckGroup);
  for (let i = 0; i < 3; i++) {
    const step = new THREE.Mesh(new THREE.BoxGeometry(5, 0.14, 1.1), darkMat);
    step.position.set(0, i * 0.14 + 0.07, 4.0 - i * 1.1);
    step.receiveShadow = true;
    deckGroup.add(step);
    addEdges(step, deckGroup);
  }
  scene.add(deckGroup);

  const archGroup = new THREE.Group();
  for (const side of [-1, 1] as const) {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(1.1, 7, 0.35), midMat);
    leg.position.set(side * 7, 3.5, -0.8);
    leg.castShadow = true;
    archGroup.add(leg);
    addEdges(leg, archGroup);
    const leg2 = new THREE.Mesh(new THREE.BoxGeometry(0.22, 6.5, 2.8), midMat);
    leg2.position.set(side * 6.3, 3.25, -2.4);
    archGroup.add(leg2);
    const strip = new THREE.Mesh(new THREE.BoxGeometry(0.06, 6.8, 0.06), accentMat);
    strip.position.set(side * (7 - side * 0.53), 3.5, -0.62);
    archGroup.add(strip);
  }
  const beam = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.55, 0.35), midMat);
  beam.position.set(0, 7.1, -0.8);
  archGroup.add(beam);
  addEdges(beam, archGroup);
  const beamTrimTop = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.07, 0.07), accentMat);
  beamTrimTop.position.set(0, 7.36, -0.63);
  archGroup.add(beamTrimTop);
  const beamTrimBot = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.07, 0.07), accentMat);
  beamTrimBot.position.set(0, 6.84, -0.63);
  archGroup.add(beamTrimBot);
  scene.add(archGroup);

  return [
    { object: flyGroup,   origin: flyGroup.position.clone(),   dir: new THREE.Vector3(0,  1, -0.2).normalize(), dist: 20, startAt: 0.0,  endAt: 0.55 },
    { object: backGroup,  origin: backGroup.position.clone(),  dir: new THREE.Vector3(0,  0.4, -1).normalize(), dist: 16, startAt: 0.05, endAt: 0.65 },
    { object: floorGroup, origin: floorGroup.position.clone(), dir: new THREE.Vector3(0, -1,   0),              dist: 7,  startAt: 0.1,  endAt: 0.75 },
    { object: deckGroup,  origin: deckGroup.position.clone(),  dir: new THREE.Vector3(0, -0.3, 1).normalize(),  dist: 11, startAt: 0.15, endAt: 0.82 },
    { object: archGroup,  origin: archGroup.position.clone(),  dir: new THREE.Vector3(0,  1,  0.15).normalize(),dist: 14, startAt: 0.2,  endAt: 0.92 },
  ];
}

// ── View Transition wiring ────────────────────────────────────────
document.addEventListener('astro:page-load', initAllViewers);

document.addEventListener('astro:before-swap', () => {
  cleanups.forEach(fn => fn());
  cleanups.clear();
});

initAllViewers();
</script>

<style>
  .viewer-root {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #0c0c0c;
  }

  .viewer-canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  /* ── Loading overlay ── */
  .viewer-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    background: #0c0c0c;
    z-index: 5;
    transition: opacity 0.9s ease;
  }

  .viewer-loading.is-loaded {
    opacity: 0;
    pointer-events: none;
  }

  .loading-svg {
    width: min(72%, 400px);
    height: auto;
    overflow: visible;
  }

  .loading-svg .text-copy {
    fill: none;
    stroke-dasharray: 6% 29%;
    stroke-width: 1.5px;
    stroke-dashoffset: 0%;
    animation: stroke-march 5.5s infinite linear;
  }

  .loading-svg .text-copy:nth-child(1) { stroke: rgba(255,255,255,0.12); animation-delay: -1s; }
  .loading-svg .text-copy:nth-child(2) { stroke: #c8a87a;               animation-delay: -2s; }
  .loading-svg .text-copy:nth-child(3) { stroke: rgba(255,255,255,0.82); animation-delay: -3s; }
  .loading-svg .text-copy:nth-child(4) { stroke: rgba(200,168,122,0.5);  animation-delay: -4s; }
  .loading-svg .text-copy:nth-child(5) { stroke: rgba(255,255,255,0.28); animation-delay: -5s; }

  @keyframes stroke-march {
    100% { stroke-dashoffset: -35%; }
  }

  .loading-bar-track {
    width: min(72%, 400px);
    height: 1px;
    background: rgba(255,255,255,0.08);
    position: relative;
  }

  .loading-bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background: #c8a87a;
    transition: width 0.25s ease;
  }

  /* ── Drag hint — top-right so it never clashes with bottom overlay ── */
  .viewer-hint {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(200, 168, 122, 0.5);
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .viewer-root:hover .viewer-hint {
    opacity: 0;
  }
</style>
