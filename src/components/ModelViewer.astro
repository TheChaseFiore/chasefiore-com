---
interface Props {
  modelUrl?: string;
  height?: string;
  autoRotate?: boolean;
  explodeButton?: boolean;
  sectionCuts?: boolean;
  mobileDrag?: boolean;
  fallbackImage?: string;
  cameraPos?: [number, number, number];
  cameraTgt?: [number, number, number];
  cycleModels?: Array<{url: string, cameraPos?: [number,number,number], cameraTgt?: [number,number,number]}>;
  initialCutZ?: number;
  navArrows?: boolean;
  mouseTilt?: boolean;
}

const { modelUrl = '', height = '500px', autoRotate = true, explodeButton = false, sectionCuts = false, mobileDrag = false, fallbackImage = '', cameraPos, cameraTgt, cycleModels, initialCutZ, navArrows = false, mouseTilt = false } = Astro.props;
---

<div
  class="viewer-root"
  style={`height: ${height}`}
  data-model-url={modelUrl}
  data-auto-rotate={String(autoRotate)}
  data-explode-button={String(explodeButton)}
  data-section-cuts={String(sectionCuts)}
  data-mobile-drag={String(mobileDrag)}
  data-fallback-image={fallbackImage}
  data-camera-pos={cameraPos ? JSON.stringify(cameraPos) : ''}
  data-camera-tgt={cameraTgt ? JSON.stringify(cameraTgt) : ''}
  data-cycle-models={cycleModels ? JSON.stringify(cycleModels) : ''}
  data-initial-cut-z={initialCutZ !== undefined ? String(initialCutZ) : ''}
  data-mouse-tilt={String(mouseTilt)}
>
  <canvas class="viewer-canvas"></canvas>

  {modelUrl && (
    <div class="viewer-loading" aria-hidden="true">
      <svg class="loading-svg" viewBox="0 0 480 90" xmlns="http://www.w3.org/2000/svg">
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
        <text class="text-copy" x="240" y="72" text-anchor="middle" font-family="system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif" font-weight="300" font-size="76" letter-spacing="4">LOADING</text>
      </svg>
      <div class="loading-bar-track">
        <div class="loading-bar-fill"></div>
      </div>
    </div>
  )}

  {fallbackImage && (
    <div class="viewer-fallback" aria-hidden="true">
      <img src={fallbackImage} alt="Preview" />
    </div>
  )}

  <slot />

  <button class="viewer-explode-btn" hidden aria-label="Explode model">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z"/></svg>
    <span>Explode</span>
  </button>

  {sectionCuts && (
    <div class="viewer-cut-bar">
      <button class="viewer-cut-btn" data-cut-axis="x" aria-label="X section cut" aria-pressed="false">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="1" width="10" height="10" rx="1"/><line x1="6" y1="1" x2="6" y2="11"/></svg>
        X
      </button>
      <button class="viewer-cut-btn" data-cut-axis="y" aria-label="Y section cut" aria-pressed="false">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="1" width="10" height="10" rx="1"/><line x1="1" y1="6" x2="11" y2="6"/></svg>
        Y
      </button>
      <button class="viewer-cut-btn" data-cut-axis="z" aria-label="Z section cut" aria-pressed="false">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="1" y="1" width="10" height="10" rx="1"/><line x1="1" y1="3" x2="11" y2="9"/></svg>
        Z
      </button>
      <div class="viewer-cut-slider-wrap" hidden>
        <input type="range" class="viewer-cut-slider" min="0" max="100" value="50" aria-label="Section cut position" />
      </div>
    </div>
  )}

  <div class="viewer-hint">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 0 1 7 7v1l2 1-2 1v3l-7 4-7-4v-3L3 10l2-1V9a7 7 0 0 1 7-7z"/><path d="M12 2v18"/></svg>
    <span>Drag to rotate</span>
  </div>

  {navArrows && (
    <button class="viewer-nav-btn viewer-nav-prev" aria-label="Previous model">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="viewer-nav-btn viewer-nav-next" aria-label="Next model">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  )}

  <div class="viewer-transition-overlay"></div>

  <div class="viewer-debug" hidden>
    <div class="vd-row"><span class="vd-label">pos</span><span class="vd-val" data-key="px"></span><span class="vd-val" data-key="py"></span><span class="vd-val" data-key="pz"></span></div>
    <div class="vd-row"><span class="vd-label">tgt</span><span class="vd-val" data-key="tx"></span><span class="vd-val" data-key="ty"></span><span class="vd-val" data-key="tz"></span></div>
    <div class="vd-row"><span class="vd-label">az</span><span class="vd-val vd-wide" data-key="az"></span><span class="vd-label">pol</span><span class="vd-val vd-wide" data-key="pol"></span></div>
  </div>
</div>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader, type GLTF } from 'three/addons/loaders/GLTFLoader.js';
import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

type CleanupFn = () => void;
const cleanups = new Map<Element, CleanupFn>();

interface ExplodePart {
  object: THREE.Object3D;
  origin: THREE.Vector3;
  dir: THREE.Vector3;
  dist: number;
  startAt: number;
  endAt: number;
}

function initAllViewers() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      observer.unobserve(el);
      el.setAttribute('data-viewer-init', '1');
      cleanups.set(el, setupViewer(el));
    });
  }, { rootMargin: '100px' });

  document.querySelectorAll<HTMLElement>('.viewer-root:not([data-viewer-init])').forEach(el => {
    observer.observe(el);
  });
}

function setupViewer(root: HTMLElement): CleanupFn {
  const canvas = root.querySelector<HTMLCanvasElement>('.viewer-canvas')!;
  const modelUrl        = root.dataset.modelUrl ?? '';
  const autoRotate      = root.dataset.autoRotate !== 'false';
  const showExplodeBtn  = root.dataset.explodeButton === 'true';
  const showSectionCuts = root.dataset.sectionCuts === 'true';
  const mobileDrag      = root.dataset.mobileDrag === 'true';
  const cameraPos: [number,number,number] = root.dataset.cameraPos ? JSON.parse(root.dataset.cameraPos) : [4.5, 5.5, 7];
  const cameraTgt: [number,number,number] = root.dataset.cameraTgt ? JSON.parse(root.dataset.cameraTgt) : [0, 3.5, 0];

  type CycleEntry = {url: string, cameraPos?: [number,number,number], cameraTgt?: [number,number,number]};
  const cycleList: CycleEntry[] = root.dataset.cycleModels ? JSON.parse(root.dataset.cycleModels) : [];
  const transOverlay = root.querySelector<HTMLElement>('.viewer-transition-overlay');
  let cycleActive = false;
  let cycleModelGroup: THREE.Object3D | null = null;
  let cycleIdx = 0;
  let cycleExplodeParts: ExplodePart[] = [];
  let cycleExplodeProgress = 0;
  let currentModelIdx = cycleList.length - 1; // treats initial model as last in cycleList
  let skipWaitFn: (() => void) | null = null;
  let manualNavDir = 0; // -1 = prev, 0 = auto/next, 1 = next
  let cycleTransitionBusy = false;
  let activeCutAxis: 'x' | 'y' | 'z' | null = null; // shared so onModelLoaded can set initial cut

  const mouseTiltEnabled = root.dataset.mouseTilt === 'true';

  // ── Scene ──────────────────────────────────────────────────────
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x0c0c0c);
  scene.fog = new THREE.FogExp2(0x0c0c0c, 0.022);

  // ── Camera ──────────────────────────────────────────────────────
  const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 200);
  camera.position.set(...cameraPos);
  camera.lookAt(...cameraTgt);

  // ── Renderer ────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.2;
  if (showSectionCuts) renderer.localClippingEnabled = true;

  // ── Section clip planes (disabled by default with large constant) ──
  const CLIP_OFF = 1e6;
  const clipX = new THREE.Plane(new THREE.Vector3(-1, 0, 0), CLIP_OFF);
  const clipY = new THREE.Plane(new THREE.Vector3(0, -1, 0), CLIP_OFF);
  const clipZ = new THREE.Plane(new THREE.Vector3(0, 0, -1), CLIP_OFF);
  if (showSectionCuts) renderer.clippingPlanes = [clipX, clipY, clipZ];

  const cutBounds = { x: [-10, 10] as [number,number], y: [0, 8] as [number,number], z: [-10, 10] as [number,number] };

  // Camera must be in the scene for camera-parented lights to work
  scene.add(camera);

  // ── Lights ──────────────────────────────────────────────────────
  // Ambient stays in world space (direction-independent)
  scene.add(new THREE.AmbientLight(0x120d08, 1.2));

  // Directional and point lights are parented to the camera so they
  // stay fixed relative to the viewpoint as the model auto-rotates.
  const keyLight = new THREE.DirectionalLight(0xfff0d8, 2.5);
  keyLight.position.set(5, 14, 10);
  keyLight.castShadow = true;
  keyLight.shadow.mapSize.set(2048, 2048);
  keyLight.shadow.camera.near = 0.5;
  keyLight.shadow.camera.far = 50;
  keyLight.shadow.camera.left = -15;
  keyLight.shadow.camera.right = 15;
  keyLight.shadow.camera.top = 15;
  keyLight.shadow.camera.bottom = -8;
  camera.add(keyLight);

  const fillLight = new THREE.DirectionalLight(0x1a2d50, 0.5);
  fillLight.position.set(-10, 4, 5);
  camera.add(fillLight);

  const rimLight = new THREE.DirectionalLight(0xc8a87a, 0.9);
  rimLight.position.set(-2, 7, -14);
  camera.add(rimLight);

  const uplightPositions = [[-4.5, 0.5, 0], [0, 0.5, 1], [4.5, 0.5, 0]] as const;
  uplightPositions.forEach(([x, y, z]) => {
    const upl = new THREE.PointLight(0xd4a870, 2.8, 10, 1.5);
    upl.position.set(x, y, z);
    camera.add(upl);
  });

  // ── Model container (supports mouse-tilt rotation) ───────────────
  const modelContainer = new THREE.Group();
  scene.add(modelContainer);

  // ── Controls ────────────────────────────────────────────────────
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.06;
  controls.autoRotate = autoRotate;
  controls.autoRotateSpeed = 0.6;
  controls.maxPolarAngle = Math.PI / 2 + 0.05;
  controls.minDistance = 3;
  controls.maxDistance = 30;
  controls.target.set(...cameraTgt);

  // ── Scroll / touch passthrough ──────────────────────────────────
  canvas.style.touchAction = mobileDrag ? 'none' : 'pan-y';

  let userInteracting = false;
  let interactTimer = 0;

  const onPointerDown = () => {
    controls.autoRotate = false;
    userInteracting = true;
    clearTimeout(interactTimer);
  };
  const onPointerUp = () => {
    interactTimer = window.setTimeout(() => {
      userInteracting = false;
      if (autoRotate) controls.autoRotate = true;
    }, 1500);
  };

  canvas.addEventListener('pointerdown', onPointerDown);
  window.addEventListener('pointerup', onPointerUp);

  root.addEventListener('wheel', (e) => {
    if (!userInteracting) e.stopPropagation();
  }, { capture: true });

  // ── Nav arrows ──────────────────────────────────────────────────
  const prevBtn = root.querySelector<HTMLButtonElement>('.viewer-nav-prev');
  const nextBtn = root.querySelector<HTMLButtonElement>('.viewer-nav-next');
  prevBtn?.addEventListener('click', () => {
    if (cycleTransitionBusy || !skipWaitFn) return;
    manualNavDir = -1;
    skipWaitFn();
  });
  nextBtn?.addEventListener('click', () => {
    if (cycleTransitionBusy || !skipWaitFn) return;
    manualNavDir = 1;
    skipWaitFn();
  });

  // ── Mouse tilt / device orientation ────────────────────────────
  let tiltX = 0, tiltY = 0, tiltTgtX = 0, tiltTgtY = 0, hasTiltInput = false;
  const tiltCleanups: Array<() => void> = [];

  if (mouseTiltEnabled) {
    const isMobile = window.matchMedia('(hover: none)').matches;

    if (!isMobile) {
      const onMove = (e: MouseEvent) => {
        if (userInteracting) return;
        const rect = canvas.getBoundingClientRect();
        tiltTgtY =  ((e.clientX - rect.left) / rect.width  - 0.5) * 0.45;
        tiltTgtX = -((e.clientY - rect.top)  / rect.height - 0.5) * 0.2;
        hasTiltInput = true;
      };
      const onLeave = () => { hasTiltInput = false; };
      canvas.addEventListener('mousemove', onMove);
      canvas.addEventListener('mouseleave', onLeave);
      tiltCleanups.push(
        () => canvas.removeEventListener('mousemove', onMove),
        () => canvas.removeEventListener('mouseleave', onLeave),
      );
    } else {
      // Mobile: device orientation drives the tilt
      const handleOrientation = (e: DeviceOrientationEvent) => {
        if (userInteracting) return;
        const gamma = e.gamma ?? 0; // left-right tilt, -90 to 90
        const beta  = e.beta  ?? 45; // front-back tilt, -180 to 180
        tiltTgtY =  (gamma / 90) * 0.35;
        tiltTgtX = -((beta - 45) / 90) * 0.18;
        hasTiltInput = true;
      };

      const startOrientation = () => {
        if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
          (DeviceOrientationEvent as any).requestPermission()
            .then((state: string) => {
              if (state === 'granted') window.addEventListener('deviceorientation', handleOrientation);
            })
            .catch(() => {});
        } else {
          window.addEventListener('deviceorientation', handleOrientation);
        }
      };

      // iOS requires a user gesture; trigger on first touch
      const onFirstTouch = () => {
        startOrientation();
        canvas.removeEventListener('pointerdown', onFirstTouch);
      };
      if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
        canvas.addEventListener('pointerdown', onFirstTouch);
        tiltCleanups.push(() => canvas.removeEventListener('pointerdown', onFirstTouch));
      } else {
        startOrientation();
      }
      tiltCleanups.push(() => window.removeEventListener('deviceorientation', handleOrientation));
    }
  }

  // ── Explode ──────────────────────────────────────────────────────
  const explodeParts: ExplodePart[] = [];
  let explodeProgress = 0;
  let explodeTarget   = 0;
  let tweenFrom       = 0;
  let tweenStart      = 0;
  let tweenDur        = 0;
  let tweenId         = 0;

  function tweenExplode(to: number, duration: number) {
    cancelAnimationFrame(tweenId);
    tweenFrom  = explodeProgress;
    explodeTarget = to;
    tweenStart = performance.now();
    tweenDur   = duration;
    function step(now: number) {
      const t = Math.min((now - tweenStart) / tweenDur, 1);
      const e = t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3) / 2;
      explodeProgress = tweenFrom + (explodeTarget - tweenFrom) * e;
      if (t < 1) tweenId = requestAnimationFrame(step);
      else explodeProgress = explodeTarget;
    }
    tweenId = requestAnimationFrame(step);
  }

  const onExplode = (e: Event) => {
    explodeProgress = (e as CustomEvent<number>).detail;
  };
  root.addEventListener('viewer:explode', onExplode);

  // ── Model cycling ────────────────────────────────────────────────
  function loadGltfAsync(url: string): Promise<GLTF> {
    return new Promise((resolve, reject) => {
      function attempt(useJs: boolean) {
        const draco = new DRACOLoader();
        draco.setDecoderPath('/draco/');
        if (useJs) draco.setDecoderConfig({ type: 'js' });
        const loader = new GLTFLoader();
        loader.setDRACOLoader(draco);
        loader.load(url, resolve, undefined, (err: unknown) => {
          if (!useJs) attempt(true);
          else reject(err);
        });
      }
      attempt(false);
    });
  }

  function prepareGltf(gltf: GLTF): THREE.Group {
    const model = gltf.scene;
    const box = new THREE.Box3().setFromObject(model);
    const center = box.getCenter(new THREE.Vector3());
    const size = box.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z);
    const scale = 8 / maxDim;
    model.scale.setScalar(scale);
    model.position.sub(center.multiplyScalar(scale));
    model.position.y += (size.y * scale) / 2;
    model.traverse((child: THREE.Object3D) => {
      if ((child as THREE.Mesh).isMesh) {
        child.castShadow = true;
        child.receiveShadow = true;
      }
    });
    return model;
  }

  function buildExplodeParts(model: THREE.Group): ExplodePart[] {
    const parts: ExplodePart[] = [];
    let source: THREE.Object3D[] = model.children.slice();
    while (source.length === 1 && source[0].children.length > 0) {
      source = source[0].children.slice();
    }
    if (source.length <= 1) return parts;
    const childCenters = new Map<THREE.Object3D, THREE.Vector3>();
    const modelBox = new THREE.Box3();
    source.forEach(child => {
      const mesh = child as THREE.Mesh;
      if (!mesh.isMesh || !mesh.geometry) return;
      mesh.geometry.computeBoundingBox();
      const gb = mesh.geometry.boundingBox;
      if (!gb || gb.isEmpty()) return;
      const ctr = gb.getCenter(new THREE.Vector3());
      childCenters.set(child, ctr);
      modelBox.expandByPoint(ctr);
    });
    if (childCenters.size <= 1) return parts;
    const center = modelBox.getCenter(new THREE.Vector3());
    const size = modelBox.getSize(new THREE.Vector3());
    const maxDim = Math.max(size.x, size.y, size.z);
    let idx = 0;
    childCenters.forEach((ctr, child) => {
      const toChild = ctr.clone().sub(center);
      const spread = toChild.length();
      let dir: THREE.Vector3;
      if (spread > 0.001) {
        dir = toChild.divideScalar(spread);
      } else {
        const a = (idx / childCenters.size) * Math.PI * 2;
        dir = new THREE.Vector3(Math.cos(a), 0.4, Math.sin(a)).normalize();
      }
      parts.push({ object: child, origin: child.position.clone(), dir, dist: Math.max(spread * 2.5, maxDim * 0.15), startAt: 0.05, endAt: 0.75 });
      idx++;
    });
    return parts;
  }

  async function doTransition(gltf: GLTF, config: CycleEntry): Promise<void> {
    if (!cycleActive || !transOverlay) return;

    // Fade-to-black during model swap
    transOverlay.classList.add('is-active');
    await new Promise<void>(res => setTimeout(res, 1000));
    if (!cycleActive) return;

    // Swap model while screen is black — new model starts assembled
    if (cycleModelGroup) modelContainer.remove(cycleModelGroup);
    const newModel = prepareGltf(gltf);
    cycleExplodeParts = buildExplodeParts(newModel);
    cycleExplodeProgress = 0;
    modelContainer.add(newModel);
    cycleModelGroup = newModel;

    const newPos = config.cameraPos ?? cameraPos;
    const newTgt = config.cameraTgt ?? cameraTgt;
    camera.position.set(...newPos);
    controls.target.set(...newTgt);
    controls.update();

    // Fade from black — model appears assembled
    await new Promise<void>(res => requestAnimationFrame(() => res()));
    transOverlay.classList.remove('is-active');
    await new Promise<void>(res => setTimeout(res, 900));
  }

  async function runNextCycle(): Promise<void> {
    if (!cycleActive) return;
    cycleTransitionBusy = false;
    manualNavDir = 0;

    // Preload the natural next model during the wait window
    const naturalIdx = cycleIdx % cycleList.length;
    let preloadGltf: GLTF | null = null;
    loadGltfAsync(cycleList[naturalIdx].url)
      .then(g => { preloadGltf = g; })
      .catch(() => {});

    // Wait 8 s or until an arrow button fires skipWaitFn
    await new Promise<void>(res => {
      const t = setTimeout(res, 8000);
      skipWaitFn = () => { clearTimeout(t); skipWaitFn = null; res(); };
    });
    skipWaitFn = null;
    if (!cycleActive) return;

    // Auto-advance: respect ongoing user interaction — wait until they let go
    if (manualNavDir === 0 && userInteracting) {
      await new Promise<void>(res => {
        const poll = () => (userInteracting ? void setTimeout(poll, 300) : res());
        setTimeout(poll, 300);
      });
      if (!cycleActive) return;
    }

    // Resolve target model index
    let targetIdx: number;
    if (manualNavDir === -1) {
      targetIdx = ((currentModelIdx - 1) % cycleList.length + cycleList.length) % cycleList.length;
    } else {
      targetIdx = naturalIdx;
    }
    currentModelIdx = targetIdx;
    cycleIdx = (targetIdx + 1) % cycleList.length;
    manualNavDir = 0;
    cycleTransitionBusy = true;

    const config = cycleList[targetIdx];
    try {
      const gltf = (targetIdx === naturalIdx && preloadGltf)
        ? preloadGltf
        : await loadGltfAsync(config.url);
      if (!cycleActive) return;
      await doTransition(gltf, config);
    } catch (err) {
      console.error('[ModelViewer] cycle load failed', err);
    }
    runNextCycle();
  }

  function startCycle(initial: THREE.Group) {
    if (cycleList.length === 0 || !transOverlay) return;
    cycleActive = true;
    cycleModelGroup = initial;
    currentModelIdx = cycleList.length - 1;
    runNextCycle();
  }

  // ── Loading overlay ──────────────────────────────────────────────
  const loadingEl = root.querySelector<HTMLElement>('.viewer-loading');

  // ── Model / Placeholder ─────────────────────────────────────────
  if (modelUrl) {
    const scheduleLoad = (window as any).requestIdleCallback
      ?? ((fn: () => void) => setTimeout(fn, 200));

    function onModelLoaded(gltf: GLTF) {
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const scale = 8 / maxDim;
      model.scale.setScalar(scale);
      model.position.sub(center.multiplyScalar(scale));
      model.position.y += (size.y * scale) / 2;
      model.traverse((child: THREE.Object3D) => {
        if ((child as THREE.Mesh).isMesh) {
          child.castShadow = true;
          child.receiveShadow = true;
        }
      });
      modelContainer.add(model);

      if (showSectionCuts) {
        const wb = new THREE.Box3().setFromObject(model);
        cutBounds.x = [wb.min.x, wb.max.x];
        cutBounds.y = [wb.min.y, wb.max.y];
        cutBounds.z = [wb.min.z, wb.max.z];

        const initialCutZVal = root.dataset.initialCutZ ? parseFloat(root.dataset.initialCutZ) : NaN;
        if (!isNaN(initialCutZVal)) {
          const t = initialCutZVal / 100;
          const [mn, mx] = cutBounds.z;
          clipZ.constant = mn + (mx - mn) * t;
          activeCutAxis = 'z';
          root.querySelector('[data-cut-axis="z"]')?.classList.add('active');
          root.querySelector('[data-cut-axis="z"]')?.setAttribute('aria-pressed', 'true');
          const slider = root.querySelector<HTMLInputElement>('.viewer-cut-slider');
          if (slider) slider.value = String(initialCutZVal);
          root.querySelector<HTMLElement>('.viewer-cut-slider-wrap')?.removeAttribute('hidden');
        }
      }

      // Manual explode button (portfolio pages only — not used when cycling)
      if (!cycleList.length) {
        explodeParts.push(...buildExplodeParts(model));
        if (showExplodeBtn && explodeParts.length > 0) {
          const btn = root.querySelector<HTMLButtonElement>('.viewer-explode-btn')!;
          const btnLabel = btn.querySelector('span')!;
          btn.removeAttribute('hidden');
          btn.addEventListener('click', () => {
            const assembling = explodeTarget > 0.5;
            if (assembling) {
              tweenExplode(0, 1800);
              btnLabel.textContent = 'Explode';
            } else {
              tweenExplode(1, 2500);
              btnLabel.textContent = 'Assemble';
            }
          });
        }
      }

      // Build explode parts for use during cycle transitions (model starts assembled)
      if (cycleList.length > 0) {
        cycleExplodeParts = buildExplodeParts(model);
      }

      if (loadingEl) {
        loadingEl.classList.add('is-loaded');
        loadingEl.addEventListener('transitionend', () => {
          loadingEl.remove();
          if (cycleList.length > 0) startCycle(model);
        }, { once: true });
      } else {
        if (cycleList.length > 0) startCycle(model);
      }
    }

    function onProgress(event: ProgressEvent) {
      if (event.lengthComputable && loadingEl) {
        const bar = loadingEl.querySelector<HTMLElement>('.loading-bar-fill');
        if (bar) bar.style.width = `${(event.loaded / event.total) * 100}%`;
      }
    }

    function onFinalError(err: unknown) {
      console.error('[ModelViewer] Failed to load', modelUrl, err);
      const fallbackEl = root.querySelector<HTMLElement>('.viewer-fallback');
      if (fallbackEl) {
        loadingEl?.remove();
        fallbackEl.removeAttribute('aria-hidden');
      } else if (loadingEl) {
        loadingEl.textContent = 'Model unavailable';
        (loadingEl as HTMLElement).style.opacity = '0.4';
      }
    }

    function tryLoad(useJsDecoder: boolean) {
      const draco = new DRACOLoader();
      draco.setDecoderPath('/draco/');
      if (useJsDecoder) draco.setDecoderConfig({ type: 'js' });
      const gltfLoader = new GLTFLoader();
      gltfLoader.setDRACOLoader(draco);
      gltfLoader.load(
        modelUrl,
        onModelLoaded,
        onProgress,
        (err: unknown) => {
          if (!useJsDecoder) {
            console.warn('[ModelViewer] WASM decoder failed, retrying with JS decoder', err);
            tryLoad(true);
          } else {
            onFinalError(err);
          }
        }
      );
    }

    scheduleLoad(() => tryLoad(false));
  } else {
    if (loadingEl) loadingEl.remove();
    explodeParts.push(...buildPlaceholder(scene));
  }

  // ── Section cut controls ──────────────────────────────────────────
  if (showSectionCuts) {
    const cutBtns    = root.querySelectorAll<HTMLButtonElement>('[data-cut-axis]');
    const sliderWrap = root.querySelector<HTMLElement>('.viewer-cut-slider-wrap');
    const slider     = root.querySelector<HTMLInputElement>('.viewer-cut-slider');

    const getPlane = (a: 'x'|'y'|'z') => a === 'x' ? clipX : a === 'y' ? clipY : clipZ;

    cutBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const axis = btn.dataset.cutAxis as 'x'|'y'|'z';
        if (activeCutAxis === axis) {
          getPlane(axis).constant = CLIP_OFF;
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
          sliderWrap?.setAttribute('hidden', '');
          activeCutAxis = null;
        } else {
          if (activeCutAxis) {
            getPlane(activeCutAxis).constant = CLIP_OFF;
            root.querySelector(`[data-cut-axis="${activeCutAxis}"]`)?.classList.remove('active');
            root.querySelector(`[data-cut-axis="${activeCutAxis}"]`)?.setAttribute('aria-pressed', 'false');
          }
          activeCutAxis = axis;
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          const [mn, mx] = cutBounds[axis];
          getPlane(axis).constant = (mn + mx) / 2;
          if (slider) slider.value = '50';
          sliderWrap?.removeAttribute('hidden');
        }
      });
    });

    slider?.addEventListener('input', () => {
      if (!activeCutAxis) return;
      const t = parseFloat(slider!.value) / 100;
      const [mn, mx] = cutBounds[activeCutAxis];
      getPlane(activeCutAxis).constant = mn + (mx - mn) * t;
    });
  }

  // ── Resize ──────────────────────────────────────────────────────
  function resize() {
    const w = root.clientWidth;
    const h = root.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h, false);
  }
  resize();
  const ro = new ResizeObserver(resize);
  ro.observe(root);

  // ── Debug overlay ────────────────────────────────────────────────
  const debugEl = root.querySelector<HTMLElement>('.viewer-debug')!;
  const debugVals = new Map<string, HTMLElement>();
  debugEl.querySelectorAll<HTMLElement>('[data-key]').forEach(el => debugVals.set(el.dataset.key!, el));

  let debugVisible = false;
  let debugFrame = 0;
  const R2D = 180 / Math.PI;
  function f(n: number) { return n.toFixed(2); }

  const onKeyDebug = (e: KeyboardEvent) => {
    if (e.key !== 'd' && e.key !== 'D') return;
    if (document.activeElement instanceof HTMLInputElement) return;
    debugVisible = !debugVisible;
    debugEl.toggleAttribute('hidden', !debugVisible);
  };
  window.addEventListener('keydown', onKeyDebug);

  // ── Loop ────────────────────────────────────────────────────────
  let rafId = 0;
  function tick() {
    rafId = requestAnimationFrame(tick);
    controls.update();

    if (mouseTiltEnabled) {
      const tgtX = hasTiltInput ? tiltTgtX : 0;
      const tgtY = hasTiltInput ? tiltTgtY : 0;
      tiltX += (tgtX - tiltX) * 0.04;
      tiltY += (tgtY - tiltY) * 0.04;
      modelContainer.rotation.x = tiltX;
      modelContainer.rotation.y = tiltY;
    }

    if (explodeProgress > 0.001 && explodeParts.length > 0) {
      for (const p of explodeParts) {
        const local = Math.min(Math.max((explodeProgress - p.startAt) / (p.endAt - p.startAt), 0), 1);
        const eased = local * local * (3 - 2 * local);
        p.object.position.copy(p.origin).addScaledVector(p.dir, p.dist * eased);
      }
    }

    if (cycleExplodeProgress > 0.001 && cycleExplodeParts.length > 0) {
      for (const p of cycleExplodeParts) {
        const local = Math.min(Math.max((cycleExplodeProgress - p.startAt) / (p.endAt - p.startAt), 0), 1);
        const eased = local * local * (3 - 2 * local);
        p.object.position.copy(p.origin).addScaledVector(p.dir, p.dist * eased);
      }
    }

    renderer.render(scene, camera);

    if (debugVisible && ++debugFrame % 6 === 0) {
      const p = camera.position;
      const t = controls.target;
      debugVals.get('px')!.textContent = f(p.x);
      debugVals.get('py')!.textContent = f(p.y);
      debugVals.get('pz')!.textContent = f(p.z);
      debugVals.get('tx')!.textContent = f(t.x);
      debugVals.get('ty')!.textContent = f(t.y);
      debugVals.get('tz')!.textContent = f(t.z);
      debugVals.get('az')!.textContent  = f(controls.getAzimuthalAngle() * R2D) + '°';
      debugVals.get('pol')!.textContent = f(controls.getPolarAngle() * R2D) + '°';
    }
  }
  tick();

  // ── Cleanup ─────────────────────────────────────────────────────
  return () => {
    cycleActive = false;
    cancelAnimationFrame(rafId);
    cancelAnimationFrame(tweenId);
    clipX.constant = clipY.constant = clipZ.constant = CLIP_OFF;
    ro.disconnect();
    controls.dispose();
    renderer.dispose();
    canvas.removeEventListener('pointerdown', onPointerDown);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('keydown', onKeyDebug);
    root.removeEventListener('viewer:explode', onExplode);
    clearTimeout(interactTimer);
    for (const p of explodeParts) p.object.position.copy(p.origin);
    for (const p of cycleExplodeParts) p.object.position.copy(p.origin);
    tiltCleanups.forEach(fn => fn());
    root.removeAttribute('data-viewer-init');
  };
}

// ── Placeholder stage geometry ────────────────────────────────────
function buildPlaceholder(scene: THREE.Scene): ExplodePart[] {
  const accent   = 0xc8a87a;
  const darkWood = 0x1a1410;
  const midWood  = 0x242018;
  const floor    = 0x0f0f0f;

  const accentMat = new THREE.MeshStandardMaterial({ color: accent,   metalness: 0.4, roughness: 0.5 });
  const darkMat   = new THREE.MeshStandardMaterial({ color: darkWood, roughness: 0.9 });
  const midMat    = new THREE.MeshStandardMaterial({ color: midWood,  roughness: 0.85 });
  const floorMat  = new THREE.MeshStandardMaterial({ color: floor,    roughness: 1.0 });
  const edgeMat   = new THREE.LineBasicMaterial({ color: 0x3a2e1e, transparent: true, opacity: 0.55 });

  function addEdges(mesh: THREE.Mesh, parent: THREE.Group) {
    const edges = new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry, 12), edgeMat.clone());
    edges.position.copy(mesh.position);
    edges.rotation.copy(mesh.rotation);
    edges.scale.copy(mesh.scale);
    parent.add(edges);
  }

  const flyGroup = new THREE.Group();
  const batten = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 12, 6), accentMat);
  batten.rotation.z = Math.PI / 2;
  batten.position.set(0, 6.6, -1.6);
  flyGroup.add(batten);
  for (let i = -5; i <= 5; i += 2.5) {
    const line = new THREE.Mesh(new THREE.CylinderGeometry(0.015, 0.015, 5, 4), darkMat);
    line.position.set(i, 4.6, -1.6);
    flyGroup.add(line);
  }
  scene.add(flyGroup);

  const backGroup = new THREE.Group();
  const backWall = new THREE.Mesh(new THREE.BoxGeometry(13, 7.5, 0.28), darkMat);
  backWall.position.set(0, 3.75, -5);
  backWall.castShadow = true;
  backGroup.add(backWall);
  addEdges(backWall, backGroup);
  for (let i = 0; i < 4; i++) {
    const x = -4.5 + i * 3;
    const col = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.16, 7, 10), midMat);
    col.position.set(x, 3.5, -4.87);
    col.castShadow = true;
    backGroup.add(col);
    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.18, 0.44), accentMat);
    cap.position.set(x, 7.09, -4.87);
    backGroup.add(cap);
    const base = new THREE.Mesh(new THREE.BoxGeometry(0.44, 0.18, 0.44), accentMat);
    base.position.set(x, -0.04, -4.87);
    backGroup.add(base);
  }
  scene.add(backGroup);

  const floorGroup = new THREE.Group();
  const ground = new THREE.Mesh(new THREE.BoxGeometry(28, 0.08, 22), floorMat);
  ground.position.y = -0.04;
  ground.receiveShadow = true;
  floorGroup.add(ground);
  const gridHelper = new THREE.GridHelper(26, 26, 0x1c1c1c, 0x161616);
  gridHelper.position.y = 0.02;
  floorGroup.add(gridHelper);
  scene.add(floorGroup);

  const deckGroup = new THREE.Group();
  const deck = new THREE.Mesh(new THREE.BoxGeometry(13, 0.45, 9), midMat);
  deck.position.set(0, 0.22, -0.5);
  deck.castShadow = true;
  deck.receiveShadow = true;
  deckGroup.add(deck);
  addEdges(deck, deckGroup);
  for (let i = 0; i < 3; i++) {
    const step = new THREE.Mesh(new THREE.BoxGeometry(5, 0.14, 1.1), darkMat);
    step.position.set(0, i * 0.14 + 0.07, 4.0 - i * 1.1);
    step.receiveShadow = true;
    deckGroup.add(step);
    addEdges(step, deckGroup);
  }
  scene.add(deckGroup);

  const archGroup = new THREE.Group();
  for (const side of [-1, 1] as const) {
    const leg = new THREE.Mesh(new THREE.BoxGeometry(1.1, 7, 0.35), midMat);
    leg.position.set(side * 7, 3.5, -0.8);
    leg.castShadow = true;
    archGroup.add(leg);
    addEdges(leg, archGroup);
    const leg2 = new THREE.Mesh(new THREE.BoxGeometry(0.22, 6.5, 2.8), midMat);
    leg2.position.set(side * 6.3, 3.25, -2.4);
    archGroup.add(leg2);
    const strip = new THREE.Mesh(new THREE.BoxGeometry(0.06, 6.8, 0.06), accentMat);
    strip.position.set(side * (7 - side * 0.53), 3.5, -0.62);
    archGroup.add(strip);
  }
  const beam = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.55, 0.35), midMat);
  beam.position.set(0, 7.1, -0.8);
  archGroup.add(beam);
  addEdges(beam, archGroup);
  const beamTrimTop = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.07, 0.07), accentMat);
  beamTrimTop.position.set(0, 7.36, -0.63);
  archGroup.add(beamTrimTop);
  const beamTrimBot = new THREE.Mesh(new THREE.BoxGeometry(15.2, 0.07, 0.07), accentMat);
  beamTrimBot.position.set(0, 6.84, -0.63);
  archGroup.add(beamTrimBot);
  scene.add(archGroup);

  return [
    { object: flyGroup,   origin: flyGroup.position.clone(),   dir: new THREE.Vector3(0,  1, -0.2).normalize(), dist: 20, startAt: 0.0,  endAt: 0.55 },
    { object: backGroup,  origin: backGroup.position.clone(),  dir: new THREE.Vector3(0,  0.4, -1).normalize(), dist: 16, startAt: 0.05, endAt: 0.65 },
    { object: floorGroup, origin: floorGroup.position.clone(), dir: new THREE.Vector3(0, -1,   0),              dist: 7,  startAt: 0.1,  endAt: 0.75 },
    { object: deckGroup,  origin: deckGroup.position.clone(),  dir: new THREE.Vector3(0, -0.3, 1).normalize(),  dist: 11, startAt: 0.15, endAt: 0.82 },
    { object: archGroup,  origin: archGroup.position.clone(),  dir: new THREE.Vector3(0,  1,  0.15).normalize(),dist: 14, startAt: 0.2,  endAt: 0.92 },
  ];
}

// ── View Transition wiring ────────────────────────────────────────
document.addEventListener('astro:page-load', initAllViewers);

document.addEventListener('astro:before-swap', () => {
  cleanups.forEach(fn => fn());
  cleanups.clear();
});

initAllViewers();
</script>

